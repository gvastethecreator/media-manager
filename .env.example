# Image Manager - ejemplo de configuración

# Entorno general
NODE_ENV=development
API_PORT=4000
API_HOST=127.0.0.1
PORT=4000
VITE_HOST=127.0.0.1

# Bind externo queda bloqueado salvo opt-in explícito
ALLOW_EXTERNAL_BIND=0

# Rutas /api/debug y /api/test-* requieren development + opt-in
ENABLE_DEBUG_ROUTES=0

# Base de datos
DATABASE_URL=file:./db.sqlite

# URLs locales. El frontend usa /api a través del broker; nunca expongas el token como VITE_*.
MEDIA_MANAGER_API_TARGET=http://127.0.0.1:4000
MEDIA_MANAGER_SESSION_ALLOWED_HOSTS=127.0.0.1:4000
MEDIA_MANAGER_SESSION_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# MEDIA_MANAGER_SESSION_TOKEN es efímero y lo generan dev:full/dev:tauri en cada lanzamiento.
# Para frontend + backend conectados usa `bun run dev:full`; los comandos aislados no comparten sesión.
CORS_ORIGIN=http://localhost:5173
VITE_APP_URL=http://localhost:5173

# Archivos y runtime
UPLOADS_DIR=public/uploads
TAURI_ENV=dev

# Logging
LOG_TO_CONSOLE=true
LOG_LEVEL=info

# Búsqueda FTS
DISABLE_FTS5=0
SEARCH_FTS_REQUIRE=0

# Feature flags
USE_EFFECT_TAGS=false
USE_EFFECT_IMAGES=false
USE_EFFECT_FOLDERS=false
