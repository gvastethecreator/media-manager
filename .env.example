# Image Manager - ejemplo de configuración

# Entorno general
NODE_ENV=development
API_PORT=4000
PORT=4000

# Base de datos
DATABASE_URL=file:./db.sqlite

# URLs locales
VITE_API_URL=http://localhost:4000/api
CORS_ORIGIN=http://localhost:5173
VITE_APP_URL=http://localhost:5173

# Archivos y runtime
UPLOADS_DIR=public/uploads
TAURI_ENV=dev

# Logging
LOG_TO_CONSOLE=true
LOG_LEVEL=info

# Búsqueda FTS
DISABLE_FTS5=0
SEARCH_FTS_REQUIRE=0

# Feature flags
USE_EFFECT_TAGS=false
USE_EFFECT_IMAGES=false
USE_EFFECT_FOLDERS=false
