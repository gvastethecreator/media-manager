**Ejemplos de implementación**:

```tsx
// Implementación de visor de imágenes modal con Dialog de Radix UI
import * as Dialog from '@radix-ui/react-dialog';
import { motion, AnimatePresence } from 'motion/react';
import { useReducedMotion } from 'motion/react';

export function ImageViewerDialog({ image, open, onOpenChange }) {
  const shouldReduceMotion = useReducedMotion();

  return (
    <Dialog.Root open={open} onOpenChange={onOpenChange}>
      <Dialog.Portal>
        <Dialog.Overlay
          className="fixed inset-0 bg-black/80 z-50"
          asChild
        >
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            transition={{ duration: shouldReduceMotion ? 0.1 : 0.3 }}
          />
        </Dialog.Overlay>

        <Dialog.Content
          className="fixed inset-0 z-50 flex items-center justify-center p-4 focus:outline-none"
          onEscapeKeyDown={() => onOpenChange(false)}
        >
          <motion.div
            className="bg-card max-w-[90vw] max-h-[90vh] rounded-lg overflow-hidden shadow-xl relative"
            initial={{ scale: 0.9, opacity: 0 }}
            animate={{ scale: 1, opacity: 1 }}
            exit={{ scale: 0.9, opacity: 0 }}
            transition={{ type: shouldReduceMotion ? 'tween' : 'spring', duration: shouldReduceMotion ? 0.2 : 0.5 }}
          >
            {/* Imagen principal */}
            <div className="relative">
              <img
                src={image.url}
                alt={image.title || "Image preview"}
                className="max-w-full max-h-[80vh] object-contain"
              />
            </div>

            {/* Información y controles de la imagen */}
            <div className="p-4 bg-card border-t">
              <h2 className="text-lg font-medium">{image.title || "Untitled"}</h2>
              <p className="text-sm text-muted-foreground">{image.description}</p>

              <div className="mt-4 flex items-center justify-between">
                <div className="flex gap-2 text-sm text-muted-foreground">
                  <span>{image.dimensions}</span>
                  <span>•</span>
                  <span>{image.size}</span>
                </div>

                <div className="flex gap-2">
                  <Dialog.Close asChild>
                    <button className="btn btn-secondary">Close</button>
                  </Dialog.Close>
                  <button className="btn btn-primary">Download</button>
                </div>
              </div>
            </div>

            {/* Botón de cierre accesible */}
            <Dialog.Close asChild>
              <button
                className="absolute top-2 right-2 w-8 h-8 rounded-full bg-black/50 text-white flex items-center justify-center hover:bg-black/70 focus:ring-2 focus:ring-white"
                aria-label="Close image viewer"
              >
                <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M11.7816 4.03157C12.0062 3.80702 12.0062 3.44295 11.7816 3.2184C11.5571 2.99385 11.193 2.99385 10.9685 3.2184L7.50005 6.68682L4.03164 3.2184C3.80708 2.99385 3.44301 2.99385 3.21846 3.2184C2.99391 3.44295 2.99391 3.80702 3.21846 4.03157L6.68688 7.49999L3.21846 10.9684C2.99391 11.193 2.99391 11.557 3.21846 11.7816C3.44301 12.0061 3.80708 12.0061 4.03164 11.7816L7.50005 8.31316L10.9685 11.7816C11.193 12.0061 11.5571 12.0061 11.7816 11.7816C12.0062 11.557 12.0062 11.193 11.7816 10.9684L8.31322 7.49999L11.7816 4.03157Z" fill="currentColor" />
                </svg>
              </button>
            </Dialog.Close>
          </motion.div>
        </Dialog.Content>
      </Dialog.Portal>
    </Dialog.Root>
  );
}

// Menú contextual para acciones de imagen
import * as ContextMenu from '@radix-ui/react-context-menu';

export function ImageContextMenu({ children, image, onEdit, onDelete, onAddToAlbum }) {
  return (
    <ContextMenu.Root>
      <ContextMenu.Trigger asChild>
        {children}
      </ContextMenu.Trigger>

      <ContextMenu.Portal>
        <ContextMenu.Content
          className="min-w-[220px] bg-card rounded-md p-1 shadow-md border z-50"
          sideOffset={5}
          align="start"
        >
          <ContextMenu.Item
            className="flex items-center h-8 px-2 text-sm rounded hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground cursor-pointer outline-none"
            onSelect={() => window.open(image.url, '_blank')}
          >
            Open in New Tab
          </ContextMenu.Item>

          <ContextMenu.Item
            className="flex items-center h-8 px-2 text-sm rounded hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground cursor-pointer outline-none"
            onSelect={onEdit}
          >
            Edit Metadata
          </ContextMenu.Item>

          <ContextMenu.Sub>
            <ContextMenu.SubTrigger className="flex items-center h-8 px-2 text-sm rounded hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground cursor-pointer outline-none justify-between">
              Add to Album
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" className="ml-auto">
                <path d="M6.1584 3.13508C6.35985 2.94621 6.67627 2.95642 6.86514 3.15788L10.6151 7.15788C10.7954 7.3502 10.7954 7.64949 10.6151 7.84182L6.86514 11.8418C6.67627 12.0433 6.35985 12.0535 6.1584 11.8646C5.95694 11.6757 5.94673 11.3593 6.1356 11.1579L9.565 7.49985L6.1356 3.84182C5.94673 3.64036 5.95694 3.32394 6.1584 3.13508Z" fill="currentColor"/>
              </svg>
            </ContextMenu.SubTrigger>

            <ContextMenu.Portal>
              <ContextMenu.SubContent className="min-w-[180px] bg-card rounded-md p-1 shadow-md border">
                {/* Lista dinámica de álbumes */}
                <ContextMenu.Item
                  className="flex items-center h-8 px-2 text-sm rounded hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground cursor-pointer outline-none"
                  onSelect={() => onAddToAlbum('album1')}
                >
                  Favorites
                </ContextMenu.Item>
                <ContextMenu.Item
                  className="flex items-center h-8 px-2 text-sm rounded hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground cursor-pointer outline-none"
                  onSelect={() => onAddToAlbum('album2')}
                >
                  Vacation Photos
                </ContextMenu.Item>
                <ContextMenu.Separator className="h-px bg-muted my-1" />
                <ContextMenu.Item
                  className="flex items-center h-8 px-2 text-sm rounded hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground cursor-pointer outline-none"
                >
                  Create New Album...
                </ContextMenu.Item>
              </ContextMenu.SubContent>
            </ContextMenu.Portal>
          </ContextMenu.Sub>

          <ContextMenu.Separator className="h-px bg-muted my-1" />

          <ContextMenu.Item
            className="flex items-center h-8 px-2 text-sm rounded text-red-500 hover:bg-red-500 hover:text-white focus:bg-red-500 focus:text-white cursor-pointer outline-none"
            onSelect={onDelete}
          >
            Delete Image
          </ContextMenu.Item>
        </ContextMenu.Content>
      </ContextMenu.Portal>
    </ContextMenu.Root>
  );
}
