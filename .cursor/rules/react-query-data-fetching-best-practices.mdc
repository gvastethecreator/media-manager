**Ejemplo de implementación**:

```typescript
// hooks/use-images.ts - Custom hook para gestión de imágenes
import { useQuery, useMutation, useQueryClient, useInfiniteQuery } from '@tanstack/react-query';
import { getImages, getImageById, updateImage, deleteImage } from '@/app/actions/images';
import type { Image, ImageUpdateInput } from '@/types/image';

// Constantes para keys de consulta
const IMAGES_KEY = 'images';
const IMAGE_DETAILS_KEY = 'image-details';

// Hook para obtener lista paginada de imágenes
export function useImages(filters = {}, pageSize = 20) {
  return useInfiniteQuery({
    queryKey: [IMAGES_KEY, filters],
    queryFn: ({ pageParam = 1 }) => getImages({ page: pageParam, limit: pageSize, ...filters }),
    getNextPageParam: (lastPage) => {
      const { pagination } = lastPage;
      return pagination.currentPage < pagination.pages ? pagination.currentPage + 1 : undefined;
    },
    initialPageParam: 1,
    staleTime: 60 * 1000, // 1 minuto
  });
}

// Hook para obtener detalles de una imagen
export function useImageDetails(id: string) {
  return useQuery({
    queryKey: [IMAGE_DETAILS_KEY, id],
    queryFn: () => getImageById(id),
    staleTime: 5 * 60 * 1000, // 5 minutos
    enabled: !!id, // Solo ejecutar si hay ID
  });
}

// Hook para actualizar metadatos de imagen
export function useUpdateImage() {
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: (data: { id: string, updates: ImageUpdateInput }) =>
      updateImage(data.id, data.updates),

    // Actualización optimista
    onMutate: async ({ id, updates }) => {
      // Cancelar queries en curso
      await queryClient.cancelQueries({ queryKey: [IMAGE_DETAILS_KEY, id] });

      // Snapshot del estado previo
      const previousImage = queryClient.getQueryData<Image>([IMAGE_DETAILS_KEY, id]);

      // Actualizar optimistamente
      if (previousImage) {
        queryClient.setQueryData<Image>([IMAGE_DETAILS_KEY, id], {
          ...previousImage,
          ...updates,
          updatedAt: new Date(),
        });
      }

      return { previousImage };
    },

    // En caso de error, revertir a datos previos
    onError: (err, { id }, context) => {
      if (context?.previousImage) {
        queryClient.setQueryData([IMAGE_DETAILS_KEY, id], context.previousImage);
      }
      console.error('Error al actualizar imagen:', err);
    },

    // Al completar exitosamente, invalidar queries relacionadas
    onSuccess: (_, { id }) => {
      queryClient.invalidateQueries({ queryKey: [IMAGE_DETAILS_KEY, id] });
      queryClient.invalidateQueries({ queryKey: [IMAGES_KEY] });
    },
  });
}

// Hook para eliminar imágenes
export function useDeleteImage() {
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: deleteImage,

    onSuccess: (_, id) => {
      // Invalidar la imagen específica
      queryClient.removeQueries({ queryKey: [IMAGE_DETAILS_KEY, id] });

      // Invalidar todas las listas que podrían contener esta imagen
      queryClient.invalidateQueries({ queryKey: [IMAGES_KEY] });
    },
  });
}

// Componente con implementación
export function ImageGallery({ albumId, tags, searchTerm }) {
  const filters = useMemo(() => ({ albumId, tags, searchTerm }), [albumId, tags, searchTerm]);
  const {
    data,
    fetchNextPage,
    hasNextPage,
    isFetchingNextPage,
    isLoading,
    error
  } = useImages(filters);

  const { ref, inView } = useInView();

  // Cargar más imágenes cuando el usuario llega al final
  useEffect(() => {
    if (inView && hasNextPage && !isFetchingNextPage) {
      fetchNextPage();
    }
  }, [inView, hasNextPage, isFetchingNextPage, fetchNextPage]);

  // Prefetching al hover
  const queryClient = useQueryClient();
  const prefetchImage = useCallback((id: string) => {
    queryClient.prefetchQuery({
      queryKey: [IMAGE_DETAILS_KEY, id],
      queryFn: () => getImageById(id),
      staleTime: 5 * 60 * 1000,
    });
  }, [queryClient]);

  return (
    <div className="image-gallery">
      {isLoading ? (
        <ImageGallerySkeleton count={12} />
      ) : error ? (
        <ErrorDisplay error={error} />
      ) : (
        <>
          <div className="image-grid">
            {data.pages.map((page) =>
              page.images.map((image) => (
                <div
                  key={image.id}
                  onMouseEnter={() => prefetchImage(image.id)}
                >
                  <ImageCard image={image} />
                </div>
              ))
            )}
          </div>

          {/* Loader infinito */}
          <div ref={ref} className="loader">
            {isFetchingNextPage && <Spinner />}
          </div>
        </>
      )}
    </div>
  );
}
```
