---
description: Best practices para acceso a datos con Prisma y migración a Drizzle
alwaysApply: false
globs: lib/prisma.ts, services/**/*.ts, app/actions/**/*.ts
---
- **Instancia única de Prisma Client:** Compartir instancia para evitar agotamiento de conexiones.
- **Migración progresiva a Drizzle:** Documentar y migrar módulos gradualmente.
- **Validación con Zod antes de persistir:** Validar todos los datos antes de guardar.
- **Transacciones para operaciones complejas.**
- **Optimización de queries:** Usar select/include y paginación.
- **Integración con Server Actions:** Acceso a datos desde Server Actions preferentemente.
- **Testing y seed de datos:** Mantener seeds y pruebas actualizadas.
- **Caché y performance:** Implementar caché LRU y optimización de índices.
- **Documentar diferencias y compatibilidad entre Prisma y Drizzle.**
- **Eliminar imports legacy de Prisma en el cliente.**
- **Diagramas mermaid para relaciones de entidades.**

```mermaid
graph TD
    A[Schema Design] --> B[Entities]
    B --> B1[Image]
    B --> B2[Album]
    B --> B3[Collection]
    B --> B4[Tag]

    A --> C[Relations]
    C --> C1[Image->Album n:m]
    C --> C2[Image->Tag n:m]
    C --> C3[Album->Collection n:1]

    A --> D[Indexes]
    D --> D1[imagePath_idx]
    D --> D2[tags_idx]
    D --> D3[albumId_idx]

    style A fill:#d4f1f9
    style B fill:#ffecb3
    style C fill:#e1bee7
    style D fill:#c8e6c9
```

**Ejemplo de implementación**:

```typescript
// lib/prisma.ts - Cliente Prisma singleton
import { PrismaClient } from '@prisma/client';
import { LRUCache } from 'lru-cache';

// Configuración de caché LRU para metadatos de imágenes
const imageMetadataCache = new LRUCache<string, any>({
  max: 1000, // Almacenar hasta 1000 items
  ttl: 1000 * 60 * 5, // 5 minutos
});

// Singleton global
const globalForPrisma = global as unknown as { prisma: PrismaClient };

export const prisma = globalForPrisma.prisma || new PrismaClient({
  log: process.env.NODE_ENV === 'development' ? ['query', 'error', 'warn'] : ['error'],
});

// Middleware para logging y auditoría
prisma.$use(async (params, next) => {
  const before = Date.now();
  const result = await next(params);
  const after = Date.now();

  if (params.model === 'Image' && params.action === 'update') {
    console.log(`Imagen ${params.args.where.id} actualizada - Tiempo: ${after - before}ms`);
  }

  return result;
});

// Estrategia de consulta optimizada para imágenes
export async function getImagesWithPagination(page = 1, limit = 20, filters = {}) {
  const cacheKey = `images_${page}_${limit}_${JSON.stringify(filters)}`;

  // Intentar usar caché primero
  if (imageMetadataCache.has(cacheKey)) {
    return imageMetadataCache.get(cacheKey);
  }

  try {
    const skip = (page - 1) * limit;
    const [images, total] = await Promise.all([
      prisma.image.findMany({
        where: filters,
        select: {
          id: true,
          path: true,
          title: true,
          createdAt: true,
          // Selección parcial para optimizar
          metadata: {
            select: {
              width: true,
              height: true,
              format: true
            }
          },
          // Solo incluir tags necesarios
          tags: {
            select: {
              name: true,
              id: true
            }
          }
        },
        skip,
        take: limit,
        orderBy: { createdAt: 'desc' }
      }),
      prisma.image.count({ where: filters })
    ]);

    const result = {
      images,
      pagination: {
        total,
        pages: Math.ceil(total / limit),
        currentPage: page
      }
    };

    // Almacenar en caché
    imageMetadataCache.set(cacheKey, result);
    return result;
  } catch (error) {
    console.error('Error en consulta de imágenes:', error);
    throw new Error('Error al obtener imágenes');
  }
}

if (process.env.NODE_ENV !== 'production') globalForPrisma.prisma = prisma;
```
