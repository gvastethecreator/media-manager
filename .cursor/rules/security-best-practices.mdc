// lib/security/image-validation.ts
import { lookup } from 'mime-types';
import { createReadStream } from 'fs';
import { fileTypeFromStream } from 'file-type';
import sharp from 'sharp';
import { nanoid } from 'nanoid';
import { join, extname, basename } from 'path';

// Lista de tipos MIME permitidos
const ALLOWED_MIME_TYPES = [
  'image/jpeg',
  'image/png',
  'image/gif',
  'image/webp',
  'image/svg+xml'
];

// Lista de extensiones permitidas
const ALLOWED_EXTENSIONS = ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.svg'];

// Tamaño máximo (10MB)
const MAX_SIZE = 10 * 1024 * 1024;

/**
 * Valida una imagen de forma estricta
 */
export async function validateImage(filePath: string): Promise<boolean> {
  try {
    // 1. Comprobar el tamaño del archivo
    const stats = await fs.stat(filePath);
    if (stats.size > MAX_SIZE) {
      throw new Error(`El archivo excede el tamaño máximo permitido de ${MAX_SIZE / (1024 * 1024)}MB`);
    }

    // 2. Comprobar extensión
    const extension = extname(filePath).toLowerCase();
    if (!ALLOWED_EXTENSIONS.includes(extension)) {
      throw new Error(`Extensión de archivo no permitida: ${extension}`);
    }

    // 3. Comprobar tipo MIME basado en extensión
    const mimeType = lookup(extension) || '';
    if (!ALLOWED_MIME_TYPES.includes(mimeType)) {
      throw new Error(`Tipo MIME no permitido: ${mimeType}`);
    }

    // 4. Comprobar tipo de archivo basado en contenido real
    const stream = createReadStream(filePath);
    const fileType = await fileTypeFromStream(stream);

    if (!fileType || !ALLOWED_MIME_TYPES.includes(fileType.mime)) {
      throw new Error(`El contenido del archivo no corresponde a una imagen válida`);
    }

    // 5. Para SVG, aplicar sanitización adicional
    if (extension === '.svg') {
      return await validateAndSanitizeSvg(filePath);
    }

    // 6. Para otros formatos, verificar que sean imágenes válidas con sharp
    await sharp(filePath).metadata();

    return true;
  } catch (error) {
    console.error('Error validando imagen:', error);
    return false;
  }
}

/**
 * Sanitiza metadatos EXIF de una imagen
 */
export async function sanitizeImageMetadata(
  inputPath: string,
  outputPath: string,
  options = { removeGps: true, removeSerialNumbers: true }
): Promise<string> {
  try {
    // Eliminar todos los metadatos excepto orientación si es necesario
    const pipeline = sharp(inputPath).rotate();

    // Mantener solo orientación si es necesaria
    if (options.removeGps && options.removeSerialNumbers) {
      await pipeline.withMetadata({ orientation: 1 }).toFile(outputPath);
    } else {
      // Leer metadatos existentes
      const metadata = await sharp(inputPath).metadata();

      // Procesar selectivamente preservando algunos datos
      if (metadata.exif) {
        // Aquí iría código para preservar solo metadatos específicos
        // y eliminar información sensible
      }

      await pipeline.toFile(outputPath);
    }

    return outputPath;
  } catch (error) {
    console.error('Error sanitizando metadatos:', error);
    throw error;
  }
}

/**
 * Genera una ruta segura para almacenar una imagen
 */
export function generateSecureImagePath(
  originalFilename: string,
  basePath: string,
  userId: string
): string {
  // Extraer extensión y sanitizar
  const extension = extname(originalFilename).toLowerCase();

  // Generar nombre aleatorio usando nanoid
  const randomId = nanoid();

  // Crear estructura de directorio basada en userId para mejor organización
  // y para evitar tener demasiados archivos en un solo directorio
  const userSubDir = userId.substring(0, 2);
  const dateDir = new Date().toISOString().split('T')[0].replace(/-/g, '');

  // Construir ruta final
  const securePath = join(basePath, userSubDir, dateDir, `${randomId}${extension}`);

  return securePath;
}

/**
 * Genera una URL firmada para acceso seguro a imágenes
 */
export function generateSignedUrl(
  imagePath: string,
  expirationMinutes = 15
): string {
  const expiration = Math.floor(Date.now() / 1000) + expirationMinutes * 60;
  const pathname = encodeURIComponent(imagePath);
  const signature = createHmac('sha256', process.env.IMAGE_SIGNING_SECRET || 'default-secret')
    .update(`${pathname}:${expiration}`)
    .digest('hex');

  return `/api/images/signed/${pathname}?expires=${expiration}&signature=${signature}`;
}

/**
 * Valida una URL firmada para acceso seguro
 */
export function validateSignedUrl(
  pathname: string,
  expires: number,
  signature: string
): boolean {
  // Verificar expiración
  if (Date.now() / 1000 > expires) {
    return false;
  }

  // Regenerar firma y comparar
  const expectedSignature = createHmac('sha256', process.env.IMAGE_SIGNING_SECRET || 'default-secret')
    .update(`${pathname}:${expires}`)
    .digest('hex');

  return signature === expectedSignature;
}
