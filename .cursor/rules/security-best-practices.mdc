```typescript
// app/api/images/upload/route.ts - Con seguridad mejorada
import { NextRequest, NextResponse } from 'next/server';
import { validateImage, sanitizeImageMetadata, generateSecureImagePath } from '@/lib/security/image-validation';
import { getServerSession } from 'next-auth';
import { authOptions } from '@/lib/auth';
import { mkdir, writeFile } from 'fs/promises';
import { join, dirname } from 'path';
import { prisma } from '@/lib/prisma';
import { RateLimiter } from '@/lib/security/rate-limiter';

// Rate limiter: 10 uploads por minuto por usuario
const uploadLimiter = new RateLimiter({
  windowMs: 60 * 1000,
  max: 10,
  keyGenerator: (req) => req.headers.get('x-forwarded-for') || 'anonymous',
  message: 'Demasiadas solicitudes de carga, por favor intente más tarde',
});

export async function POST(request: NextRequest) {
  try {
    // 1. Autenticación
    const session = await getServerSession(authOptions);
    if (!session?.user?.id) {
      return NextResponse.json({ error: 'No autorizado' }, { status: 401 });
    }

    // 2. Rate limiting
    const limitResult = await uploadLimiter.check(request);
    if (!limitResult.success) {
      return NextResponse.json(
        { error: limitResult.message },
        { status: 429 }
      );
    }

    // 3. Procesamiento de archivo
    const formData = await request.formData();
    const file = formData.get('file') as File;

    if (!file) {
      return NextResponse.json(
        { error: 'No se proporcionó ningún archivo' },
        { status: 400 }
      );
    }

    // 4. Validación de tamaño
    if (file.size > 10 * 1024 * 1024) {
      return NextResponse.json(
        { error: 'El archivo excede el tamaño máximo permitido (10MB)' },
        { status: 400 }
      );
    }

    // 5. Guardar archivo en ubicación temporal
    const bytes = await file.arrayBuffer();
    const buffer = Buffer.from(bytes);

    const tempDir = join(process.cwd(), 'tmp');
    await mkdir(tempDir, { recursive: true });
    const tempFilePath = join(tempDir, `temp-${Date.now()}-${file.name}`);
    await writeFile(tempFilePath, buffer);

    // 6. Validación estricta del archivo
    const isValidImage = await validateImage(tempFilePath);
    if (!isValidImage) {
      // Eliminar archivo temporal inválido
      await unlink(tempFilePath);
      return NextResponse.json(
        { error: 'El archivo no es una imagen válida' },
        { status: 400 }
      );
    }

    // 7. Generar ruta segura para almacenamiento
    const uploadDir = join(process.cwd(), 'uploads', session.user.id);
    const securePath = generateSecureImagePath(file.name, uploadDir, session.user.id);

    // 8. Asegurar que existe el directorio
    await mkdir(dirname(securePath), { recursive: true });

    // 9. Sanitizar metadatos EXIF
    await sanitizeImageMetadata(tempFilePath, securePath, {
      removeGps: true,
      removeSerialNumbers: true
    });

    // 10. Eliminar archivo temporal
    await unlink(tempFilePath);

    // 11. Guardar en la base de datos con resultado
    const image = await prisma.image.create({
      data: {
        userId: session.user.id,
        path: securePath,
        originalFilename: file.name,
        mimeType: file.type,
        size: file.size,
        isPublic: false,
        uploadedAt: new Date(),
        title: formData.get('title') as string || file.name,
      }
    });

    // 12. Añadir a la cola de procesamiento
    // ...

    return NextResponse.json({ success: true, imageId: image.id }, { status: 201 });
  } catch (error) {
    console.error('Error en upload de imagen:', error);
    return NextResponse.json(
      { error: 'Error procesando la imagen' },
      { status: 500 }
    );
  }
}