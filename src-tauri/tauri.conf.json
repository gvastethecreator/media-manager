{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Media Manager",
	"version": "0.1.0",
	"identifier": "com.imagemanager.app",
	"build": {
		"frontendDist": "../dist/client",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "bun run dev:vite",
		"beforeBuildCommand": "bun run build:vite"
	},
	"app": {
		"windows": [
			{
				"title": "Media Manager",
				"width": 1200,
				"height": 800,
				"minWidth": 800,
				"minHeight": 600,
				"resizable": true,
				"fullscreen": false,
				"center": true
			}
		],
		"security": {
			"csp": {
				"default-src": "'self' customprotocol: asset:",
				"connect-src": "'self' ipc: http://127.0.0.1:* http://localhost:*",
				"font-src": "'self' data:",
				"img-src": "'self' asset: http://asset.localhost blob: data: http://127.0.0.1:* http://localhost:*",
				"media-src": "'self' asset: blob: data: http://127.0.0.1:* http://localhost:*",
				"script-src": "'self' 'wasm-unsafe-eval'",
				"style-src": "'self' 'unsafe-inline'",
				"worker-src": "'self' blob:"
			},
			"devCsp": {
				"default-src": "'self' data: blob: asset:",
				"connect-src": "'self' ipc: http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*",
				"font-src": "'self' data:",
				"img-src": "'self' asset: http://asset.localhost blob: data: http://127.0.0.1:* http://localhost:*",
				"media-src": "'self' asset: blob: data: http://127.0.0.1:* http://localhost:*",
				"script-src": "'self' 'unsafe-eval' 'wasm-unsafe-eval'",
				"style-src": "'self' 'unsafe-inline'",
				"worker-src": "'self' blob:"
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"resources": {
			"../dist/server/index.js": "server/index.js",
			"../src/lib/drizzle/migrations/": "server/migrations/"
		}
	}
}
