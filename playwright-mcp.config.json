{
  "name": "Image Manager E2E Tests",
  "settings": {
    "baseURL": "http://localhost:5174",
    "timeout": 30000,
    "viewport": {
      "width": 1280,
      "height": 720
    }
  },
  "selectors": {
    "dashboard": "main, [data-testid='dashboard'], #root",
    "navigation": "nav, [data-testid='navigation']",
    "apps": "[data-testid='app-card'], .app-item",
    "editToggle": "[data-testid='edit-toggle']",
    "dragHandle": "[data-testid='drag-handle']",
    "searchInput": "input[type='search'], [data-testid='search']",
    "loadingSpinner": "[data-testid='loading'], .loading"
  },
  "testScenarios": [
    {
      "name": "Homepage Load Test",
      "description": "Verificar que la página principal carga correctamente",
      "steps": [
        "Navigate to the homepage",
        "Wait for main content to load",
        "Verify main content is visible",
        "Take screenshot for visual verification"
      ]
    },
    {
      "name": "Navigation Test",
      "description": "Probar la navegación básica de la aplicación",
      "steps": [
        "Navigate to the homepage",
        "Wait for navigation elements",
        "Verify navigation is visible",
        "Test navigation links functionality"
      ]
    },
    {
      "name": "Responsive Design Test",
      "description": "Verificar que la aplicación es responsive",
      "steps": [
        "Navigate to the homepage",
        "Change viewport to mobile",
        "Verify mobile layout",
        "Change viewport to tablet",
        "Verify tablet layout",
        "Change viewport to desktop",
        "Verify desktop layout"
      ]
    },
    {
      "name": "Search Functionality Test",
      "description": "Probar la funcionalidad de búsqueda",
      "steps": [
        "Navigate to the homepage",
        "Locate search input",
        "Enter search term",
        "Verify search results",
        "Clear search",
        "Verify results are cleared"
      ]
    }
  ]
}
