/**
 * @file Slice para agrupación y selección del store de imágenes
 * @module store/entities/image/slices/grouping
 */

import { Logger } from '@/lib/logger';
import { transformImageToExtended, transformImageToWithStats } from '@/transformers/image/transformer';
import type { ImageExtended, ImageGroupType, ImageSortCriteria, ImageWithStats } from '@/types/entities/image';
import { format } from 'date-fns';
import type { StateCreator } from 'zustand';
import type { ImageGroup, ImageState, ImageStoreStats } from '../types';

// Logger para el slice
const groupingLogger = new Logger('ImageGroupingSlice');
const selectionLogger = new Logger('ImageSelectionSlice');

// Slice para agrupación y selección
export interface ImageGroupingSlice {
	// Estado de agrupación
	grouping: {
		groupBy: ImageGroupType | null;
		sortCriteria: ImageSortCriteria;
	};
	groupedImages: ImageGroup[];
	filteredImages: ImageExtended[];
	stats: ImageStoreStats;

	// Estado de selección
	selection: {
		selectedIds: string[];
	};

	// Acciones de agrupación
	recalculateGroups: (allImages: ImageExtended[]) => void;
	setGroupBy: (groupBy: ImageGroupType | null) => void;
	setSortCriteria: (sortCriteria: ImageSortCriteria) => void;
	sortImages: (images: ImageExtended[], criteria: ImageSortCriteria) => ImageExtended[];

	// Acciones de selección
	toggleSelection: (imageId: string) => void;
	selectRange: (imageId: string) => void;
	selectAll: () => void;
	clearSelection: () => void;
	updateIsSelectedState: () => void;

	// Utilidades
	getVisibleImages: (includeStats?: boolean) => ImageExtended[] | ImageWithStats[];
	calculateStats: (images: ImageWithStats[]) => ImageStoreStats;
}

// Creador del slice
export const createImageGroupingSlice: StateCreator<ImageState, [], [], ImageGroupingSlice> = (set, get) => ({
	// Estado inicial
	grouping: {
		groupBy: null,
		sortCriteria: 'date' as ImageSortCriteria,
	},
	groupedImages: [],
	filteredImages: [],
	stats: {
		total: 0,
		favorites: 0,
		public: 0,
		private: 0,
		withThumbnails: 0,
		withoutThumbnails: 0,
		fileTypes: {},
		largest: null,
		smallest: null,
		newest: null,
		oldest: null,
	},
	selection: {
		selectedIds: [],
	},

	// Función para ordenar imágenes
	sortImages: (images: ImageExtended[], sortCriteria: ImageSortCriteria): ImageExtended[] => {
		return [...images].sort((a, b) => {
			switch (sortCriteria) {
				case 'name':
					return a.name.localeCompare(b.name);
				case 'date':
					return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();
				case 'size':
					return (b.size || 0) - (a.size || 0);
				default:
					return 0;
			}
		});
	},

	/**
	 * Recalcula los grupos de imágenes basado en la configuración actual
	 */
	recalculateGroups: (allImages: ImageExtended[]) => {
  const { groupBy, sortCriteria } = get().grouping;
  const { selectedIds } = get().selection;
  groupingLogger.info('🔄 Recalculando grupos', { groupBy, sortCriteria });

  if (!groupBy || !allImages.length) {
    set({ groupedImages: [], stats: get().calculateStats(allImages) });
    return;
  }

  const groups: Record<string, ImageExtended[]> = {};

  for (const image of allImages) {
    let key: string | null = null;

    if (groupBy === 'month') {
      key = format(new Date(image.createdAt), 'yyyy-MM');
    } else if (groupBy === 'day') {
      key = format(new Date(image.createdAt), 'yyyy-MM-dd');
    } else if (groupBy === 'folder') {
      key = image.folderId || 'Uncategorized'; // TODO: Get folder name?
    } else if (groupBy === 'tag') {
      if (image.tags && image.tags.length > 0) {
        // Si agrupa por tag, puede pertenecer a múltiples grupos
        for (const tag of image.tags) {
          const tagKey = tag.id;
          if (!groups[tagKey]) {
            groups[tagKey] = [];
          }
          groups[tagKey].push({ ...image, isSelected: selectedIds.includes(image.id) });
        }
        continue; // Pasar a la siguiente imagen, ya que se añadió a sus grupos de tags
      } else {
        key = 'Untagged';
      }
    } else if (groupBy === 'album') {
      if (image.albums && image.albums.length > 0) {
         // Si agrupa por album, puede pertenecer a múltiples grupos
         for (const album of image.albums) {
          const albumKey = album.id;
          if (!groups[albumKey]) {
            groups[albumKey] = [];
          }
          groups[albumKey].push({ ...image, isSelected: selectedIds.includes(image.id) });
         }
         continue; // Pasar a la siguiente imagen
      } else {
          key = 'Uncategorized';
      }
    }

    if (key) {
      if (!groups[key]) {
        groups[key] = [];
      }
      groups[key].push({ ...image, isSelected: selectedIds.includes(image.id) });
    }
  }

  // Convertir a array y ordenar
  const groupedArray: ImageGroup[] = Object.entries(groups).map(([key, images]) => ({
    id: key,
    type: groupBy,
    label: key, // TODO: Mejorar label (nombre de mes, carpeta, tag...)
    images: get().sortImages(images, sortCriteria),
    count: images.length
  }));

		// Ordenar los grupos
		groupedArray.sort((a, b) => {
			if (groupBy === 'month' || groupBy === 'day') {
				return b.label.localeCompare(a.label); // Fecha más reciente primero
			}
			// TODO: Añadir lógica de ordenación para otros tipos de grupos si es necesario
			return a.label.localeCompare(b.label);
		});

		set({ groupedImages: groupedArray, stats: get().calculateStats(allImages as ImageWithStats[]) });
		groupingLogger.info('✅ Grupos recalculados:', groupedArray.length);
	},

	/**
	 * Establece el criterio de agrupación y recalcula los grupos
	 */
	setGroupBy: (groupBy: ImageGroupType | null) => {
		groupingLogger.info('🏷️ Estableciendo agrupación por:', groupBy);
		set((state) => ({
			grouping: { ...state.grouping, groupBy },
		}));
		get().recalculateGroups(get().getVisibleImages(true) as ImageExtended[]);
	},

	/**
	 * Establece el criterio de ordenación y reordena los grupos existentes
	 */
	setSortCriteria: (sortCriteria: ImageSortCriteria) => {
		groupingLogger.info('⇅ Estableciendo ordenación por:', sortCriteria);
		set((state) => ({
			grouping: { ...state.grouping, sortCriteria },
		}));
		// Reordenar las imágenes dentro de cada grupo existente
		const reorderedGroups = get().groupedImages.map(group => ({
			...group,
			images: get().sortImages(group.images as ImageExtended[], sortCriteria)
		}));
		set({ groupedImages: reorderedGroups });
	},

/**
 * Selecciona o deselecciona una imagen
 * @param imageId ID de la imagen
 */
toggleSelection: (imageId: string) => {
  const { selectedIds } = get().selection;
  const isSelected = selectedIds.includes(imageId);
  selectionLogger.info(`🖱️ Selección ${isSelected ? 'quitada' : 'añadida'} para imagen:`, imageId);

  set((state) => ({
    selection: {
      selectedIds: isSelected
        ? selectedIds.filter((id) => id !== imageId)
        : [...selectedIds, imageId],
    },
  }));

  // Actualizar estado `isSelected` en las listas
  get().updateIsSelectedState();
},

/**
 * Selecciona un rango de imágenes (Shift + Click)
 * @param imageId ID de la imagen final del rango
 */
selectRange: (imageId: string) => {
  const { selectedIds } = get().selection;
  const visibleImages = get().getVisibleImages(false); // Obtener imágenes visibles actualmente
  selectionLogger.info('🖱️ Selección de rango hasta:', imageId);

  if (selectedIds.length === 0) {
    // Si no hay nada seleccionado, solo seleccionar el clickeado
    get().toggleSelection(imageId);
    return;
  }

  const lastSelectedId = selectedIds[selectedIds.length - 1];
  const lastIndex = visibleImages.findIndex((img) => img.id === lastSelectedId);
  const currentIndex = visibleImages.findIndex((img) => img.id === imageId);

  if (lastIndex === -1 || currentIndex === -1) {
    // Si algo salió mal (índices no encontrados), solo seleccionar el actual
    get().toggleSelection(imageId);
    return;
  }

  const start = Math.min(lastIndex, currentIndex);
  const end = Math.max(lastIndex, currentIndex);
  const rangeIds = visibleImages.slice(start, end + 1).map((img) => img.id);

  set((state) => ({
    selection: {
      // Añadir los IDs del rango a la selección actual (evitando duplicados)
      selectedIds: Array.from(new Set([...state.selection.selectedIds, ...rangeIds])),
    },
  }));
  get().updateIsSelectedState();
},

/**
 * Selecciona todas las imágenes visibles
 */
selectAll: () => {
  const visibleImages = get().getVisibleImages(false);
  const allIds = visibleImages.map((img) => img.id);
  selectionLogger.info(`🖱️ Seleccionando todas las (${allIds.length}) imágenes visibles`);
  set({ selection: { selectedIds: allIds } });
  get().updateIsSelectedState();
},

/**
 * Deselecciona todas las imágenes
 */
clearSelection: () => {
  selectionLogger.info('🖱️ Limpiando selección');
  set({ selection: { selectedIds: [] } });
  get().updateIsSelectedState();
},

/**
 * Actualiza el estado `isSelected` en las listas de imágenes
 * (filteredImages y groupedImages) después de un cambio en la selección.
 * Esto evita tener que recalcular todos los grupos.
 */
updateIsSelectedState: () => {
  const { selectedIds } = get().selection;
  const currentFiltered = get().filteredImages;
  const currentGrouped = get().groupedImages;

  const needsUpdate = currentFiltered.some(img => img.isSelected !== selectedIds.includes(img.id)) ||
                    currentGrouped.some(group => group.images.some(img => img.isSelected !== selectedIds.includes(img.id)));

  if (!needsUpdate) return; // No hacer nada si no hay cambios

  set(state => ({
      filteredImages: currentFiltered.map(img => (
          img.isSelected !== selectedIds.includes(img.id)
          ? { ...img, isSelected: selectedIds.includes(img.id) }
          : img
      )),
      groupedImages: currentGrouped.map(group => (
          group.images.some(img => img.isSelected !== selectedIds.includes(img.id))
          ? {
              ...group,
              images: group.images.map(img => (
                  img.isSelected !== selectedIds.includes(img.id)
                  ? { ...img, isSelected: selectedIds.includes(img.id) }
                  : img
              ))
            }
          : group
      ))
  }));
},

// --- Utility functions accessible within the store ---
getVisibleImages: (includeStats: boolean = false): ImageExtended[] | ImageWithStats[] => {
  const { groupedImages, filteredImages } = get();
  const images = groupedImages.length > 0
      ? groupedImages.flatMap(group => group.images)
      : filteredImages;

  if (includeStats) {
      return images as ImageWithStats[]; // Asumimos que ya tienen stats si vienen de applyFilters
  }
  return images as ImageExtended[];
},

/**
 * Calcula estadísticas básicas sobre un conjunto de imágenes
 */
calculateStats: (images: ImageWithStats[]): ImageStoreStats => {
  const stats: ImageStoreStats = {
      total: images.length,
      favorites: 0,
      public: 0,
      private: 0,
      withThumbnails: 0,
      withoutThumbnails: 0,
      fileTypes: {},
      largest: null,
      smallest: null,
      newest: null,
      oldest: null,
  };

  if (!images.length) return stats;

  let largest: ImageWithStats | null = null;
  let smallest: ImageWithStats | null = null;
  let newest: ImageWithStats | null = null;
  let oldest: ImageWithStats | null = null;

  for (const image of images) {
      if (image.isFavorite) stats.favorites++;
      if (image.isPublic) stats.public++;
      else stats.private++;
      if (image.thumbnailPath) stats.withThumbnails++;

      // Contar tipos de archivo
      const format = image.metadata?.format || 'unknown';
      stats.fileTypes[format] = (stats.fileTypes[format] || 0) + 1;

      // Comparar tamaño (si existe metadata)
      const size = image.metadata?.sizeBytes;
      if (size !== undefined) {
          if (!largest || size > (largest.metadata?.sizeBytes ?? -1)) {
              largest = image;
          }
          if (!smallest || size < (smallest.metadata?.sizeBytes ?? Infinity)) {
              smallest = image;
          }
      }

      // Comparar fecha
      const date = new Date(image.createdAt);
      if (!newest || date > new Date(newest.createdAt)) {
          newest = image;
      }
      if (!oldest || date < new Date(oldest.createdAt)) {
          oldest = image;
      }
  }

  stats.withoutThumbnails = images.length - stats.withThumbnails;
  stats.largest = largest ? transformImageToExtended(transformImageToWithStats(largest)) : null;
  stats.smallest = smallest ? transformImageToExtended(transformImageToWithStats(smallest)) : null;
  stats.newest = newest ? transformImageToExtended(transformImageToWithStats(newest)) : null;
  stats.oldest = oldest ? transformImageToExtended(transformImageToWithStats(oldest)) : null;

  return stats;
}
});