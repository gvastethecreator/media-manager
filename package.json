{
	"name": "image-manager",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "electron/dist/main.cjs",
	"scripts": {
		"dev:full": "bun scripts/dev-full.js",
		"dev:vite": "bun scripts/dev-vite-headers.js",
		"dev:vite:app": "vp dev",
		"dev:vite:original": "vp dev",
		"dev:server:hot": "bun scripts/dev-server-hot.js",
		"desktop:dev": "bun scripts/desktop-dev.js",
		"desktop:build-shell": "bun scripts/build-electron-shell.js",
		"desktop:prepare-resources": "bun scripts/prepare-extraresources.ts",
		"desktop:inventory": "bun scripts/write-extraresources-inventory.ts",
		"build": "bun scripts/run-with-log.js build \"bun run build:vite && bun run build:server\"",
		"build:vite": "bun scripts/run-with-log.js build-vite bun scripts/build-vite.ts",
		"build:server": "bun scripts/run-with-log.js build-server bun build src/server/index.ts --outdir dist/server --target bun",
		"desktop:package": "bun run build && bun run desktop:build-shell && bun run desktop:prepare-resources && bun run desktop:inventory && bun scripts/desktop-package.ts",
		"desktop:make": "electron-forge make",
		"start": "bun scripts/start-production.ts",
		"preview": "vp preview",
		"check": "bun scripts/run-with-log.js check \"bun run lint && bun run tsc\"",
		"check:fix": "bun scripts/run-with-log.js check-fix bun run lint:fix",
		"check:full": "bun scripts/run-with-log.js vp-check \"bun run format:check && bun run lint && bun run tsc\"",
		"check:full:fix": "bun scripts/run-with-log.js vp-check-fix \"bun run format && bun run lint:fix && bun run tsc\"",
		"format": "bun scripts/run-with-log.js oxfmt-write vp fmt --write",
		"format:check": "bun scripts/run-with-log.js oxfmt-check vp fmt --check",
		"lint": "bun scripts/run-with-log.js oxlint vp lint",
		"lint:fix": "bun scripts/run-with-log.js oxlint-fix vp lint --fix",
		"tsc": "bun scripts/run-with-log.js tsc bunx tsc --noEmit --pretty",
		"test": "bun scripts/run-with-log.js test bun scripts/run-tests-isolated.ts --run --silent=true",
		"test:watch": "bun scripts/run-with-log.js test-watch bun scripts/run-tests-isolated.ts",
		"test:unit": "bun scripts/run-with-log.js test-unit bun scripts/run-tests-isolated.ts --run --silent=true",
		"test:ci": "bun scripts/run-with-log.js test-unit bun scripts/run-tests-isolated.ts --run --coverage --silent=true",
		"test:tooling": "bun scripts/run-tooling-tests-isolated.ts",
		"test:e2e": "bun scripts/run-with-log.js test-e2e bunx playwright test",
		"test:e2e:production": "bun run build && bun scripts/run-with-log.js test-e2e-production bun scripts/run-production-smoke.ts",
		"test:ui": "bun scripts/run-with-log.js test-e2e bunx playwright test --ui",
		"test:e2e:debug": "bun scripts/run-with-log.js test-e2e-debug bunx playwright test --debug",
		"perf:doctor": "bunx react-doctor .",
		"perf:doctor:verbose": "bunx react-doctor . --verbose",
		"perf:doctor:score": "bunx react-doctor . --score",
		"perf:doctor:diff": "bunx react-doctor . --diff main --verbose",
		"db:studio": "bun scripts/db/studio.js",
		"db:migrate": "bun scripts/db/migrations.ts migrate",
		"db:adopt-legacy": "bun scripts/db/legacy-adoption.ts",
		"db:status": "bun scripts/db/migrations.ts status",
		"db:plan": "bun scripts/db/migrations.ts plan",
		"db:check": "bun scripts/db/migrations.ts check",
		"db:schema:check": "bun scripts/db/generate-schema-contract.ts",
		"db:schema:export": "bun scripts/db/export-schema.ts",
		"db:orphans": "bun scripts/db/orphan-inventory.ts",
		"db:inventory": "bun scripts/db/safe-backup.ts inventory",
		"db:backup": "bun scripts/db/safe-backup.ts backup",
		"db:backup:verify": "bun scripts/db/safe-backup.ts verify",
		"db:backup:prune": "bun scripts/db/backup-retention.ts",
		"db:restore": "bun scripts/db/safe-backup.ts restore",
		"db:upgrade": "bun scripts/db/upgrade.ts",
		"db:image:backfill": "bun scripts/db/image-asset-backfill.ts",
		"db:image:reconcile": "bun scripts/db/image-asset-reconcile.ts",
		"db:media:backfill": "bun scripts/db/media-specialization-asset-backfill.ts",
		"db:media:reconcile": "bun scripts/db/media-specialization-asset-reconcile.ts",
		"db:mark-disposable": "bun scripts/db/reset.ts mark",
		"db:reset": "bun scripts/db/reset.ts reset",
		"db:generate-video-thumbnails": "bun scripts/run-with-log.js db-thumbnails bun scripts/generate-video-thumbnails.ts",
		"db:generate-audio-thumbnails": "bun scripts/run-with-log.js db-thumbnails bun scripts/generate-audio-thumbnails.ts",
		"db:generate-all-thumbnails": "bun scripts/run-with-log.js db-thumbnails-all \"bun run db:generate-video-thumbnails && bun run db:generate-audio-thumbnails\"",
		"logs:list": "bun scripts/logging-utils.js list",
		"logs:clean": "bun scripts/logging-utils.js clean",
		"check:errors": "bun scripts/check-errors.js",
		"deps:outdated": "bun scripts/run-with-log.js deps-outdated bun outdated",
		"deps:update": "bun scripts/run-with-log.js deps-update \"bun update --latest\"",
		"playwright:install": "bunx playwright install",
		"playwright:codegen": "bunx playwright codegen http://localhost:5173",
		"audit": "bun scripts/run-with-log.js audit \"bun run check && bun run test:unit\""
	},
