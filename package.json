  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "pnpm dev:vite",
    "build": "pnpm build:vite && pnpm build:server",
    "start": "pnpm preview:vite",
    "preview": "pnpm preview:vite",
    "lint": "node scripts/run-with-log.js eslint npx eslint .",
    "lint:fix": "node scripts/run-with-log.js eslint-fix npx eslint . --fix",
    "biome:check": "node scripts/run-with-log.js biome-check npx biome check --max-diagnostics=500 .",
    "biome:fix": "node scripts/run-with-log.js biome-fix npx biome check --max-diagnostics=500 --write .",
    "biome:format": "node scripts/run-with-log.js biome-format npx biome format --write .",
