    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:debug": "npx playwright test --debug",
    "logs": "node scripts/logging-utils.js",
    "logs:list": "node scripts/logging-utils.js list",
    "logs:clean": "node scripts/logging-utils.js clean",
    "check:errors": "node scripts/check-errors.js",
    "analyze": "node scripts/analyze/index.mjs",
    "db:full-reset": "node scripts/db/reset.js",
    "db:check": "node scripts/db/check.js",
    "db:studio": "node scripts/db/studio.js",
    "playwright:install": "npx playwright install",
    "playwright:codegen": "npx playwright codegen http://localhost:3000",
    "playwright:helper": "node scripts/playwright-mcp-helper.js",
    "playwright:generate": "node scripts/playwright-mcp-helper.js generate-tests",
    "playwright:scenarios": "node scripts/playwright-mcp-helper.js list-scenarios",
    "db:update-folder-stats": "node scripts/update-folder-stats.js",
    "db:stats": "pnpm db:update-folder-stats",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "preview:vite": "vite preview",
    "build:server": "tsup",
    "watch:server": "tsup --watch --onSuccess \"node dist/server/index.js\"",
    "release:windows": "pnpm desktop:tauri && pwsh scripts/ps/zip-release.ps1 %npm_package_version%"
  },
