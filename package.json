{
  "name": "image-manager",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.ts,.jsx,.tsx",
    "lint:fix": "eslint . --ext .js,.ts,.jsx,.tsx --fix",
    "lint:report": "node scripts/lint-report.js",
    "lint:staged": "eslint --fix $(git diff --staged --name-only --diff-filter=ACMR | grep -E \"\\.(js|jsx|ts|tsx)$\")",
    "format": "prettier --check \"**/*.{js,ts,jsx,tsx,json,css,scss,md}\"",
    "format:fix": "prettier --write \"**/*.{js,ts,jsx,tsx,json,css,scss,md}\"",
    "ts:check": "node scripts/ts-check.js",
    "ts:unused": "npx ts-unused-exports tsconfig.json --excludePathsFromReport=\"node_modules,\\.next,build,dist\"",
    "ts:circular": "npx madge --circular --extensions ts,tsx src",
    "validate": "npm run lint && npm run ts:check && npm run format",
    "validate:fix": "npm run lint:fix && npm run format:fix",
    "analyze": "node scripts/analyze/index.mjs",
    "analyze:code": "node scripts/analyze/index.mjs --only=code",
    "analyze:deps": "node scripts/analyze/index.mjs --only=dependencies",
    "analyze:perf": "node scripts/analyze/index.mjs --only=performance",
    "analyze:structure": "node scripts/analyze/index.mjs --only=structure",
    "db:reset": "prisma migrate reset --force",
    "db:clean": "rimraf prisma/dev.db",
    "db:setup": "prisma generate && prisma migrate dev --name init",
    "db:seed": "prisma db seed",
    "db:full-reset": "rimraf prisma/dev.db && prisma migrate dev --name init",
    "db:migrate-favorites": "ts-node --project tsconfig.seed.json prisma/migrations/migrate-favorites-to-fields.ts",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio",
    "drizzle:introspect": "drizzle-kit introspect",
    "drizzle:drop": "drizzle-kit drop",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
