{
  "name": "image-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run dev:vite",
    "dev:full": "bun scripts/dev-full.js",
    "dev:simple": "bun run dev:vite & bun run dev:server:hot",
    "build": "bun run build:vite && bun run build:server",
    "start": "bun run preview:vite",
    "preview": "bun run preview:vite",

    "dev:vite": "bunx --bun vite",
    "build:vite": "bunx --bun vite build",
    "preview:vite": "bunx --bun vite preview",

    "build:server": "bun build src/server/index.ts --outdir dist/server --target node",
    "watch:server": "bun build src/server/index.ts --outdir dist/server --target node --watch",
    "dev:server": "bun run watch:server",
    "dev:server:hot": "bun scripts/dev-server-hot.js",
    "start:server": "bun dist/server/index.js",

    "lint": "bun scripts/run-with-log.js eslint bunx eslint .",
    "lint:fix": "bun scripts/run-with-log.js eslint-fix bunx eslint . --fix",
    "format": "bun scripts/run-with-log.js biome-format bunx biome format --write .",
    "format:check": "bun scripts/run-with-log.js format-check bunx biome format --check .",
    "check": "bun scripts/run-with-log.js biome-check bunx biome check --max-diagnostics=500 .",
    "check:fix": "bun scripts/run-with-log.js biome-fix bunx biome check --max-diagnostics=500 --write .",
    "fix:all": "bun scripts/run-with-log.js fix-all \"bunx eslint . --fix && bunx biome check --max-diagnostics=500 --write .\"",
    "tsc": "bun scripts/run-with-log.js tsc bunx tsc --noEmit --pretty",

    "test": "bun run test:e2e",
    "test:ui": "bun scripts/run-with-log.js test-e2e bunx playwright test --ui",
    "test:e2e": "bun scripts/run-with-log.js test-e2e bunx playwright test",
    "test:e2e:headed": "bunx playwright test --headed",
    "test:e2e:debug": "bunx playwright test --debug",

    "db:studio": "bunx drizzle-kit studio",
    "db:push": "bunx drizzle-kit push",
    "db:check": "bunx drizzle-kit check",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:reset": "bun scripts/db/reset.js",
    "db:verify": "bun scripts/db/verify-drizzle-migration.ts",

    "logs": "bun scripts/logging-utils.js",
    "logs:list": "bun scripts/logging-utils.js list",
    "logs:clean": "bun scripts/logging-utils.js clean",
    "check:errors": "bun scripts/check-errors.js",

    "playwright:install": "bunx playwright install",
    "playwright:codegen": "bunx playwright codegen http://localhost:5174"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "vite": "^7.0.1",

    "express": "^5.1.0",
    "drizzle-orm": "^0.44.2",
    "@libsql/client": "^0.15.9",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",

    "zustand": "^5.0.6",
    "@tanstack/react-query": "^5.81.5",
    "@tanstack/react-query-devtools": "^5.81.5",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",

    "lucide-react": "^0.525.0",
    "radix-ui": "latest",
    "tailwindcss": "^4.1.11",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "class-variance-authority": "^0.7.1",
    "next-themes": "^0.4.6",
    "framer-motion": "^12.23.0",
    "motion": "^12.23.0",

    "react-hook-form": "^7.59.0",
    "@hookform/resolvers": "^5.1.1",
    "react-resizable-panels": "^3.0.3",
    "react-hotkeys-hook": "^5.1.0",
    "react-intersection-observer": "^9.16.0",
    "react-error-boundary": "^6.0.0",

    "cmdk": "1.1.1",
    "vaul": "^1.1.2",
    "input-otp": "^1.4.2",
    "sonner": "^2.0.6",
    "react-day-picker": "^9.7.0",
    "react-color": "^2.19.3",
    "react-colorful": "^5.6.1",
    "emoji-picker-react": "^4.12.3",
    "emojilib": "^4.0.2",
    "@hello-pangea/dnd": "^18.0.1",
    "embla-carousel-react": "^8.6.0",
    "recharts": "^3.0.2",
    "react-json-tree": "^0.20.0",
    "react-json-view-lite": "^2.4.1",
    "@uiw/react-md-editor": "^4.0.7",
    "react-simplemde-editor": "^5.2.0",

    "sharp": "^0.34.2",
    "exifreader": "^4.31.1",
    "html2canvas": "^1.4.1",
    "dom-to-image-more": "^3.6.0",

    "zod": "^3.25.71",
    "date-fns": "^4.1.0",
    "lodash": "^4.17.21",
    "uuid": "^11.1.0",
    "nanoid": "^5.1.5",
    "mime-types": "^3.0.1",
    "lru-cache": "11.1.0",
    "p-queue": "^8.1.0",
    "reselect": "^5.1.1",
    "immer": "^10.1.1",
    "usehooks-ts": "^3.1.1",

    "bull": "^4.16.5",
    "@bull-board/api": "^6.11.0",
    "@bull-board/express": "^6.11.0",
    "express-jwt": "^8.5.1",
    "jose": "^6.0.11",
    "event-source-polyfill": "^1.0.31",
    "event-source-stream": "^1.6.0",

    "chalk": "^5.4.1",
    "chokidar": "^4.0.3",
    "geist": "^1.4.2",
    "react-scan": "^0.4.3",

    "@types/express": "^5.0.3",
    "@types/mime-types": "^3.0.1",
    "@types/uuid": "^10.0.0"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "@vitejs/plugin-react": "^4.6.0",
    "vite-plugin-svgr": "^4.3.0",
    "vite-tsconfig-paths": "^5.1.4",

    "@biomejs/biome": "2.0.6",
    "@eslint/js": "^9.30.1",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.30.1",

    "@playwright/test": "^1.53.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitest/ui": "^3.2.4",
    "vitest": "^3.2.4",
    "happy-dom": "^18.0.1",
    "supertest": "^7.1.1",
    "node-mocks-http": "^1.17.2",

    "drizzle-kit": "^0.31.4",

    "postcss": "^8.5.6",
    "@tailwindcss/postcss": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "tw-animate-css": "^1.3.5",

    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-color": "^3.0.13",
    "@types/react-router-dom": "^5.3.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/event-source-polyfill": "^1.0.5",
    "@types/glob": "^9.0.0",
    "@types/lodash": "^4.17.20",
    "@types/supertest": "^6.0.3",

    "dotenv": "^17.0.1",
    "glob": "^11.0.3",
    "tsx": "^4.20.3",
    "ts-node": "^10.9.2"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@biomejs/biome",
      "@tailwindcss/oxide",
      "better-sqlite3",
      "esbuild",
      "exifreader",
      "msgpackr-extract",
      "sharp",
      "unrs-resolver"
    ]
  }
}
