{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noForEach": "error"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "noNodejsModules": "off"

      },
      "suspicious": {
        "noConsoleLog": "off",
        "noExplicitAny": "error"
      },
      "a11y": {
        "useAltText": "error",
        "useKeyWithClickEvents": "error"
      },
      "style": {
        "useConst": "error",
        "useTemplate": "error",
        "useNodejsImportProtocol": "off"
      },
      "performance": {
        "noDelete": "error"
      }

    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "files": {
    "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.json"],
    "ignore": [
      "**/node_modules/**",
      "**/.next/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.image-cache/**",
      "**/.thumbnail-cache/**",
      "**/public/assets/**"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "always"
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    },
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
