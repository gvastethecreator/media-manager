// Modelo para la configuración de filtros
model LayerFilterConfig {
  id              String   @id @default(cuid())
  entityType      String
  entityId        String?
  isDefault       Boolean  @default(false)
  enabled         Boolean  @default(true)
  visibleOnHover  Boolean  @default(false)
  opacity         Float    @default(1)
  intensity       Float    @default(1)

  // Configuración de Glow como JSON
  glow            Json?    @default("{\"enabled\":false,\"color\":\"rgba(0, 0, 255, 0.3)\",\"radius\":10,\"intensity\":0.5}")

  // Configuración de Shadow como JSON
  shadow          Json?    @default("{\"enabled\":true,\"color\":\"rgba(0, 0, 0, 0.3)\",\"blur\":5,\"offsetX\":0,\"offsetY\":5,\"inset\":false}")

  // Configuración de Distortion como JSON
  distortion      Json?    @default("{\"enabled\":false,\"type\":\"wave\",\"amount\":5,\"speed\":1,\"animated\":false}")

  layerIndex      Int      @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([entityType, entityId], name: "entityType_entityId")
  @@index([entityType])
}
