// Modelo para configuración de la parte trasera de tarjetas
model BacksideConfig {
  id             String   @id @default(cuid())
  entityType     String
  entityId       String?
  isDefault      Boolean  @default(false)
  enabled        Boolean  @default(true)

  // Diseño y estilo
  layoutType     String   @default("standard") // standard, tabbed, grid, minimal
  colorMode      String   @default("inherit") // inherit, custom, reverse, contrast
  customColor    String?
  opacity        Float    @default(0.95)
  blurBackground Boolean  @default(true)
  blurAmount     Float    @default(10)

  // Contenido
  showAttributes     Boolean  @default(true)
  showDescription    Boolean  @default(true)
  showStats          Boolean  @default(true)
  showMetadata       Boolean  @default(true)
  showRelations      Boolean  @default(false)
  attributesConfig   String?  @default("{}") // JSON para configurar atributos visibles
  maxDescriptionLength Int?   @default(300)

  // Interacción
  flipAnimation    String   @default("rotate") // rotate, fade, flip3d, slide
  flipDuration     Int      @default(600)
  enableAutoFlip   Boolean  @default(false)
  autoFlipDelay    Int      @default(3000)
  flipTrigger      String   @default("click") // click, hover, doubleClick

  // Propiedades avanzadas
  customBackgroundImage String?
  customTemplate        String?

  // Estilo de UI
  headingStyle     String   @default("default") // default, large, subtle, accent
  infoStyle        String   @default("default") // default, pills, cards, minimal
  separatorStyle   String   @default("line") // line, dotted, gradient, none

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relación con CardConfiguration
  cardConfiguration CardConfiguration?

  @@unique([entityType, entityId], name: "backside_entity")
  @@index([entityType, isDefault])
}

// Modelo para configuración de Core de tarjetas
model CoreConfig {
  id                String   @id @default(cuid())
  entityType        String
  entityId          String?
  isDefault         Boolean  @default(false)

  // Sistema de capas
  layerSystem       Json?    @default("{\"order\":[\"background\",\"content\",\"effects\",\"holographic\",\"border\",\"filter\"],\"layerBlending\":\"screen\",\"layerSpacing\":2}")

  // Interactividad
  interactiveMode   String   @default("hover") // hover, click, none
  hoverDelay        Int      @default(100)
  touchBehavior     String   @default("tap") // tap, longPress, doubleTap
  pointerPrecision  String   @default("medium") // low, medium, high
  motionReduction   Boolean  @default(false)

  // Rendimiento
  performanceMode   String   @default("balanced") // performance, balanced, quality
  enableCache       Boolean  @default(true)
  loadingStrategy   String   @default("progressive") // eager, lazy, progressive
  enablePreloading  Boolean  @default(true)

  // Feedback y Respuesta
  enableHaptics     Boolean  @default(false)
  hapticIntensity   Float    @default(0.5)
  enableSounds      Boolean  @default(false)
  soundVolume       Float    @default(0.5)
  soundTheme        String   @default("minimal")

  // Contenido
  contentArrangement String   @default("standard") // standard, compact, expanded, minimal
  enableAutoHeight   Boolean  @default(true)
  maxLines           Int?
  textTruncation     String   @default("ellipsis") // ellipsis, fade, scroll
  mediaFit           String   @default("cover") // cover, contain, fill

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relación con CardConfiguration
  cardConfiguration CardConfiguration?

  @@unique([entityType, entityId], name: "core_entity")
  @@index([entityType, isDefault])
}
