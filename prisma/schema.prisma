// Modelo para la configuración del efecto glitch
model LayerGlitchEffectConfig {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String   @default("default")
  isDefault     Boolean  @default(false)

  // Propiedades básicas
  enabled       Boolean  @default(true)
  intensity     Float    @default(0.1)
  frequency     Float    @default(0.05)
  duration      Float    @default(0.2)

  // Comportamiento
  visibleOnHover Boolean  @default(true)
  triggerOnHover Boolean  @default(false)
  randomTrigger  Boolean  @default(false)
  randomFrequency Float   @default(0.1)
  stopAfterSeconds Float? @default(2)
  affectContent  Boolean  @default(true)

  // Propiedades de efecto
  sliceCount     Int     @default(10)
  sliceOffset    Float   @default(5)
  colorShiftAmount Float  @default(0.1)
  noiseIntensity  Float  @default(0.2)
  scanlineEffect  Boolean @default(true)
  distortionType  String  @default("digital")
  blendMode       String  @default("overlay")
  rgbShiftEnabled Boolean @default(true)
  brightnessNoise Float   @default(0.1)
  staticNoise     Float   @default(0.05)

  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Índices y restricciones
  @@unique([entityType, entityId])
  @@index([entityType, isDefault])
}

