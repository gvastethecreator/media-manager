// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Modelo para el sistema de colas
model QueueJob {
  id          String    @id @default(cuid())
  queue       String
  data        String
  status      String    @default("pending")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  error       String?
  progress    Int       @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  priority    Int       @default(0)
  metadata    String?
  retryAt     DateTime?

  @@index([queue, status])
  @@index([status, createdAt])
  @@index([priority, status, createdAt])
  @@index([retryAt])
}

// Modelo para el perfil de usuario ( separar en otra db para el futuro)
model Profile {
  id          String   @id @default(cuid())
  name        String
  emoji       String   @default("👤")
  color       String   @default("#3b82f6")
  theme       String   @default("system")
  language    String   @default("es")
  description String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Modelo para las carpetas
model Folder {
  id             String              @id @default(cuid())
  name           String
  description    String?
  path           String              @unique
  parentId       String?
  parent         Folder?             @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children       Folder[]            @relation("FolderToFolder")
  images         Image[]
  videos         Video[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  visualConfigId String?             @unique
  visualConfig   FolderVisualConfig? @relation(fields: [visualConfigId], references: [id])
  totalFiles     Int                 @default(0)
  totalSize      Int                 @default(0)
  lastIndexed    DateTime?           @default(now())
  autoReindex    Boolean             @default(false)
  featuredImage  String?
  isFavorite     Boolean             @default(false)
  emoji          String?             @default("📁")
  color          String?             @default("#3b82f6")

  @@index([path])
  @@index([lastIndexed])
  @@index([createdAt])
}

// Modelo para la configuración visual de carpetas
model FolderVisualConfig {
  id                      String   @id @default(cuid())
  folder                  Folder?
  enable3DEffect          Boolean  @default(true)
  designSystem            Json?    @default("{\"preset\":\"modern\",\"cornerStyle\":\"rounded\",\"elevation\":2}")
  enableHolographicEffect Boolean  @default(true)
  enableGlowEffect        Boolean  @default(true)
  enableAnimatedBorder    Boolean  @default(true)
  enableLightHalo         Boolean  @default(true)
  layerSystem             Json?    @default("{\"order\":[\"background\",\"content\",\"effects\",\"holographic\",\"border\",\"filter\"],\"layerBlending\":\"screen\",\"layerSpacing\":2}")
  effects                 Json?    @default("{\"shadow\":{\"enabled\":true,\"color\":\"rgba(0,0,0,0.2)\",\"blur\":10,\"spread\":5},\"reflection\":{\"enabled\":true,\"opacity\":0.1,\"blur\":2},\"parallax\":{\"enabled\":true,\"intensity\":0.1,\"perspective\":1000}}")
  performance             Json?    @default("{\"enableHardwareAcceleration\":true,\"useRAF\":true,\"batchUpdates\":true,\"throttleMs\":16}")
  states                  Json?    @default("{\"hover\":{\"scale\":1.02,\"rotate\":true,\"lift\":true,\"duration\":200,\"easing\":\"cubic-bezier(0.4,0,0.2,1)\"},\"active\":{\"scale\":0.98,\"brightness\":0.95},\"disabled\":{\"opacity\":0.5,\"grayscale\":true}}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// Modelo para las imágenes
model Image {
  id                   String             @id @default(cuid())
  name                 String
  description          String?
  path                 String             @unique
  folderId             String
  folder               Folder             @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  visualConfigId       String?            @unique
  visualConfig         ImageVisualConfig? @relation(fields: [visualConfigId], references: [id])
  hash                 String
  size                 Int
  width                Int
  height               Int
  metadata             String?
  thumbnail            Bytes?
  thumbnailSize        Int?
  thumbnailWidth       Int?
  thumbnailHeight      Int?
  thumbnailError       String?
  thumbnailErrorAt     DateTime?
  thumbnailOptimizedAt DateTime?
  isPublic             Boolean            @default(false)
  isFavorite           Boolean            @default(false)
  collections          Collection[]       @relation("ImageToCollection")
  tags                 Tag[]              @relation("ImageToTag")
  activities           Activity[]
  stats                ImageStats?
  albums               Album[]            @relation("ImageToAlbum")
  characters           Character[]        @relation("ImageToCharacter")
  places               Place[]            @relation("ImageToPlace")
  worldItems           WorldItem[]        @relation("ImageToWorldItem")
  concepts             Concept[]          @relation("ImageToConcept")
  prompts              Prompt[]           @relation("ImageToPrompt")
  notes                Note[]             @relation("ImageToNote")

  @@unique([path, folderId], name: "path_folderId")
  @@index([folderId])
  @@index([hash])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([isPublic])
  @@index([isFavorite])
}

// Modelo para las estadísticas de las imágenes
model ImageStats {
  id         String   @id @default(cuid())
  imageId    String   @unique
  image      Image    @relation(fields: [imageId], references: [id])
  views      Int      @default(0)
  downloads  Int      @default(0)
  lastViewed DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([imageId])
}

// Modelo para las actividades de las imágenes
model Activity {
  id          String   @id @default(cuid())
  type        String
  description String
  imageId     String?
  image       Image?   @relation(fields: [imageId], references: [id])
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([imageId])
}

// Modelo para las imágenes subidas
model UploadedImage {
  id        String   @id @default(cuid())
  name      String
  path      String   @unique
  type      String   @default("icon")
  category  String   @default("system")
  size      Int
  width     Int
  height    Int
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([createdAt])
}

// Entidades generales

// Modelo para los álbumes

model Album {
  id          String   @id @default(cuid())
  name        String   @unique
  emoji       String   @default("📸")
  description String?
  color       String   @default("#3b82f6")
  shortcut    String?
  sortBy      String   @default("name")
  filters     String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  images      Image[]  @relation("ImageToAlbum")
  category    String?
  rarity      String?  @default("common")
  texture     String?

  @@index([name])
  @@index([createdAt])
  @@index([rarity])
  @@index([category])
}

model Tag {
  id            String   @id @default(cuid())
  name          String   @unique
  emoji         String   @default("🏷️")
  color         String   @default("#3b82f6")
  description   String?
  shortcut      String?
  featuredImage String?
  isFavorite    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  images        Image[]  @relation("ImageToTag")
  category      String?
  rarity        String?  @default("common")
  texture       String?

  @@index([name])
  @@index([createdAt])
  @@index([rarity])
  @@index([category])
}

model Collection {
  id             String   @id @default(cuid())
  name           String   @unique
  emoji          String   @default("🌟")
  description    String?
  color          String   @default("#3b82f6")
  shortcut       String?
  sortBy         String   @default("name")
  filters        String   @default("[]")
  url            String?
  alternativeUrl String?
  sourceImage    String?
  platform       String?
  price          Float?
  editions       String   @default("[]")
  featuredImage  String?
  isFavorite     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  images         Image[]  @relation("ImageToCollection")
  category       String?
  rarity         String?  @default("common")
  texture        String?

  @@index([name])
  @@index([createdAt])
  @@index([rarity])
  @@index([category])
}

// Modelo para los personajes
model Character {
  id                   String      @id @default(cuid())
  name                 String      @unique
  emoji                String      @default("👤")
  color                String      @default("#3b82f6")
  description          String?
  shortcut             String?
  level                Int         @default(1)
  class                String      @default("unknown")
  race                 String      @default("unknown")
  alignment            String      @default("neutral")
  backstory            String      @default("")
  stats                String      @default("{}")
  sortBy               String      @default("name")
  filters              String      @default("[]")
  psychologicalProfile String      @default("")
  socialProfile        String      @default("")
  relationships        String      @default("[]")
  goals                String      @default("[]")
  fears                String      @default("[]")
  beliefs              String      @default("[]")
  personality          String      @default("[]")
  featuredImage        String?
  isFavorite           Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  images               Image[]     @relation("ImageToCharacter")
  relatedCharacters    Character[] @relation("CharacterRelations")
  relatedTo            Character[] @relation("CharacterRelations")
  notes                Note[]      @relation("CharacterToNote")
  concepts             Concept[]   @relation("CharacterToConcept")
  prompts              Prompt[]    @relation("CharacterToPrompt")
  category             String?

  @@index([name])
  @@index([createdAt])
  @@index([class])
  @@index([race])
}

// Modelo para los lugares
model Place {
  id            String    @id @default(cuid())
  name          String    @unique
  emoji         String    @default("📍")
  color         String    @default("#3b82f6")
  description   String?
  shortcut      String?
  region        String    @default("unknown")
  type          String    @default("unknown")
  climate       String    @default("temperate")
  population    Int       @default(0)
  government    String    @default("unknown")
  dangers       String    @default("[]")
  resources     String    @default("[]")
  lore          String    @default("")
  history       String    @default("")
  stats         String    @default("{}")
  sortBy        String    @default("name")
  filters       String    @default("[]")
  featuredImage String?
  isFavorite    Boolean   @default(false)
  notes         Note[]    @relation("PlaceToNote")
  concepts      Concept[] @relation("PlaceToConcept")
  prompts       Prompt[]  @relation("PlaceToPrompt")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  images        Image[]   @relation("ImageToPlace")
  category      String?

  @@index([name])
  @@index([createdAt])
  @@index([type])
  @@index([climate])
  @@index([region])
}

// Modelo para los objetos del mundo
model WorldItem {
  id            String    @id @default(cuid())
  name          String    @unique
  emoji         String    @default("🎯")
  color         String    @default("#3b82f6")
  description   String?
  shortcut      String?
  type          String    @default("misc")
  rarity        String    @default("common")
  properties    String    @default("[]")
  requirements  String    @default("{}")
  origin        String    @default("")
  stats         String    @default("{}")
  sortBy        String    @default("name")
  filters       String    @default("[]")
  featuredImage String?
  isFavorite    Boolean   @default(false)
  notes         Note[]    @relation("WorldItemToNote")
  concepts      Concept[] @relation("WorldItemToConcept")
  prompts       Prompt[]  @relation("WorldItemToPrompt")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  images        Image[]   @relation("ImageToWorldItem")
  category      String?

  @@index([name])
  @@index([createdAt])
  @@index([type])
  @@index([rarity])
}

// Modelo para los conceptos
model Concept {
  id            String      @id @default(cuid())
  name          String      @unique
  emoji         String      @default("💡")
  color         String      @default("#3b82f6")
  description   String?
  content       String      @default("")
  category      String      @default("general")
  tags          String      @default("[]")
  featuredImage String?
  isFavorite    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  characters    Character[] @relation("CharacterToConcept")
  places        Place[]     @relation("PlaceToConcept")
  worldItems    WorldItem[] @relation("WorldItemToConcept")
  notes         Note[]      @relation("ConceptToNote")
  prompts       Prompt[]    @relation("ConceptToPrompt")
  images        Image[]     @relation("ImageToConcept")

  @@index([name])
  @@index([category])
  @@index([createdAt])
}

// Modelo para los prompts
model Prompt {
  id            String      @id @default(cuid())
  name          String      @unique
  emoji         String      @default("🎯")
  color         String      @default("#3b82f6")
  description   String?
  content       String      @default("")
  category      String      @default("general")
  parameters    String      @default("{}")
  tags          String      @default("[]")
  featuredImage String?
  isFavorite    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  characters    Character[] @relation("CharacterToPrompt")
  places        Place[]     @relation("PlaceToPrompt")
  worldItems    WorldItem[] @relation("WorldItemToPrompt")
  concepts      Concept[]   @relation("ConceptToPrompt")
  notes         Note[]      @relation("PromptToNote")
  images        Image[]     @relation("ImageToPrompt")

  @@index([name])
  @@index([category])
  @@index([createdAt])
}

// Modelo para las notas
model Note {
  id            String      @id @default(cuid())
  title         String
  content       String      @default("")
  category      String      @default("general")
  priority      Int         @default(0)
  status        String      @default("active")
  tags          String      @default("[]")
  featuredImage String?
  isFavorite    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  characters    Character[] @relation("CharacterToNote")
  places        Place[]     @relation("PlaceToNote")
  worldItems    WorldItem[] @relation("WorldItemToNote")
  concepts      Concept[]   @relation("ConceptToNote")
  prompts       Prompt[]    @relation("PromptToNote")
  images        Image[]     @relation("ImageToNote")

  @@index([title])
  @@index([category])
  @@index([priority])
  @@index([status])
  @@index([createdAt])
}

// Modelo para configuración de tarjetas de entidades
model CardConfiguration {
  id         String @id @default(cuid())
  entityType String @unique

  // Sistema de diseño
  designSystemPreset       String? @default("default") // 'default', 'modern', 'classic', 'minimal', 'elegant'
  designSystemVariant      String?
  designSystemAspectRatio  String?
  designSystemCornerStyle  String? @default("rounded") // 'rounded', 'sharp', 'beveled'
  designSystemCornerRadius Int?    @default(12)
  designSystemElevation    Int?    @default(2)
  designSystemShadowStyle  String? @default("soft") // 'soft', 'hard', 'layered', 'none'

  // Visual
  showTitle       Boolean? @default(true)
  showType        Boolean? @default(true)
  showDescription Boolean? @default(true)
  showRarity      Boolean? @default(true)
  showTexture     Boolean? @default(true)
  showInfo        Boolean? @default(true)
  showImageCount  Boolean? @default(true)

  // Imagen
  imageGridLayout      String? @default("single") // 'single', 'dual', 'quad', 'six'
  imageGridGap         Int?    @default(4)
  imageGridStyle       String? @default("standard") // 'standard', 'masonry', 'carousel'
  imageGridAspectRatio String? @default("16/9")

  // Efectos
  enableGlow                Boolean @default(true)
  enableScanlines           Boolean @default(false)
  enableGrainEffect         Boolean @default(false)
  enableLightHalo           Boolean @default(false)
  enableAnimatedBorder      Boolean @default(false)
  enable3DEffect            Boolean @default(true)
  enableHolographicEffect   Boolean @default(true)
  enableGlitchEffect        Boolean @default(false)
  enableChromaticAberration Boolean @default(false)
  enablePixelate            Boolean @default(false)
  maxRotation               Int     @default(15)
  hoverLiftHeight           Int     @default(10)

  // Sistema
  enableShadow    Boolean? @default(true)
  cardShadowSize  String?  @default("md") // 'sm', 'md', 'lg', 'xl', '2xl'
  cardShadowColor String?  @default("rgba(0,0,0,0.2)")
  cardRoundedSize String?  @default("md") // 'none', 'sm', 'md', 'lg', 'xl', '2xl', 'full'
  cardBorderSize  String?  @default("sm") // 'none', 'sm', 'md', 'lg'

  // Avanzado
  enableHoverAnimation Boolean? @default(true)
  enableParallaxEffect Boolean? @default(false)
  enableBlurEffect     Boolean? @default(false)

  // Rendimiento
  enableLazyLoading Boolean? @default(true)
  enablePrefetch    Boolean? @default(false)
  enableSkeleton    Boolean? @default(true)

  // Estados
  enableHover    Boolean? @default(true)
  enableActive   Boolean? @default(true)
  enableFocus    Boolean? @default(true)
  enableDisabled Boolean? @default(false)

  // Sistemas
  raritySystem   Boolean @default(false)
  textureSystem  Boolean @default(false)
  categorySystem Boolean @default(true)

  // Colores
  primaryColor   String @default("#3b82f6")
  secondaryColor String @default("#8b5cf6")

  // Opciones avanzadas serializadas como JSON
  holographicOptions         String? // JSON stringified
  scanlinesOptions           String? // JSON stringified
  glowOptions                String? // JSON stringified
  borderOptions              String? // JSON stringified
  grainOptions               String? // JSON stringified
  glitchOptions              String? // JSON stringified {enabled, intensity, frequency, duration}
  chromaticAberrationOptions String? // JSON stringified {enabled, intensity, offset}
  pixelateOptions            String? // JSON stringified {enabled, intensity, blockSize}

  // Estados y Animaciones
  statesConfig String? // JSON stringified {hover, focus, active, selected, scales, rotations, translations}

  // Efectos Visuales
  visualEffectsConfig String? // JSON stringified {brightness, contrast, saturate, hueRotate, etc}

  // Rendimiento
  performanceConfig String? // JSON stringified {lazyLoad, imageOptimization, etc}

  // Efectos Avanzados
  effectsConfig String? // JSON stringified {holographic, scanlines, glow, grain, glitch, chromaticAberration, pixelate}

  // Campos de auditoría
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Referencias a nuevos modelos
  backsideConfigId String? @unique
  backsideConfig   BacksideConfig? @relation(fields: [backsideConfigId], references: [id])

  coreConfigId     String? @unique
  coreConfig       CoreConfig? @relation(fields: [coreConfigId], references: [id])

  @@map("card_configurations")
}

// Modelo para rarezas
model Rarity {
  id              String  @id @default(cuid())
  entityType      String
  name            String
  color           String  @default("#3b82f6")
  borderEffect    String?
  borderWidth     Float?  @default(2)
  borderPattern   String? @default("solid")
  borderAnimation String? @default("none")
  glowColor       String?
  glowIntensity   Float?  @default(5)
  glowSize        Float?  @default(100)
  glowAnimation   String? @default("none")
  badgeClass      String?
  barClass        String?
  description     String?
  position        Int     @default(0)
  chance          Float   @default(0)
  unlockCondition String?

  // Efectos de distorsión
  enableGlitchEffect        Boolean @default(false)
  glitchIntensity           Float?  @default(0.5)
  glitchFrequency           Float?  @default(1)
  glitchDuration            Float?  @default(0.2)
  enableChromaticAberration Boolean @default(false)
  chromaticIntensity        Float?  @default(0.5)
  chromaticOffset           Float?  @default(0.1)
  enablePixelate            Boolean @default(false)
  pixelateIntensity         Float?  @default(0.5)
  pixelateBlockSize         Int?    @default(4)
  enableDistortion          Boolean @default(false)
  distortionIntensity       Float?  @default(0.5)
  distortionType            String? @default("wave") // 'wave', 'ripple', 'twist'
  enableBlur                Boolean @default(false)
  blurAmount                Float?  @default(0.5)
  blurType                  String? @default("gaussian") // 'gaussian', 'motion', 'radial'

  specialEffects String?  @default("{}") // JSON para efectos especiales adicionales
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([entityType, name], name: "entityType_name")
  @@index([entityType])
}

// Modelo para texturas
model Texture {
  id             String  @id @default(cuid())
  entityType     String
  name           String
  imageUrl       String?
  patternType    String?
  color          String  @default("#3b82f6")
  opacity        Float   @default(0.5)
  description    String?
  blendMode      String? @default("overlay")
  noiseType      String? @default("light")
  animated       Boolean @default(false)
  animationSpeed Float?  @default(1)
  density        Float?  @default(0.6)
  contrast       Float?  @default(1.2)
  visibleOnHover Boolean @default(false)
  layerOrder     Int     @default(6)

  // Efectos de distorsión avanzados
  distortion            Float?   @default(0)
  distortionType        String?  @default("wave") // 'wave', 'ripple', 'twist', 'noise'
  distortionSpeed       Float?   @default(1)
  distortionScale       Float?   @default(1)
  blur                  Float?   @default(0)
  blurType              String?  @default("gaussian") // 'gaussian', 'motion', 'radial'
  blurAngle             Float?   @default(0)
  blurRadius            Float?   @default(10)
  octaves               Int?     @default(3)
  persistence           Float?   @default(0.5)
  lacunarity            Float?   @default(2)
  baseFrequency         Float?   @default(1)
  seed                  Int?     @default(0)
  turbulence            Float?   @default(1)
  fractalType           String?  @default("fbm") // 'fbm', 'ridged', 'cellular'
  cellularType          String?  @default("euclidean") // 'euclidean', 'manhattan', 'chebyshev'
  cellularDistance      String?  @default("euclidean") // 'euclidean', 'manhattan', 'chebyshev'
  cellularJitter        Float?   @default(1)
  cellularScale         Float?   @default(1)
  cellularOctaves       Int?     @default(3)
  cellularPersistence   Float?   @default(0.5)
  cellularLacunarity    Float?   @default(2)
  cellularBaseFrequency Float?   @default(1)
  cellularSeed          Int?     @default(0)
  cellularTurbulence    Float?   @default(1)
  cellularFractalType   String?  @default("fbm") // 'fbm', 'ridged', 'cellular'
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([entityType, name], name: "entityType_name")
  @@index([entityType])
}

model ImageVisualConfig {
  id                      String   @id @default(cuid())
  image                   Image?
  enable3DEffect          Boolean  @default(true)
  designSystem            Json?    @default("{\"preset\":\"modern\",\"cornerStyle\":\"rounded\",\"elevation\":2}")
  enableHolographicEffect Boolean  @default(true)
  enableGlowEffect        Boolean  @default(true)
  enableAnimatedBorder    Boolean  @default(true)
  enableLightHalo         Boolean  @default(true)
  layerSystem             Json?    @default("{\"order\":[\"background\",\"content\",\"effects\",\"holographic\",\"border\",\"filter\"],\"layerBlending\":\"screen\",\"layerSpacing\":2}")
  effects                 Json?    @default("{\"shadow\":{\"enabled\":true,\"color\":\"rgba(0,0,0,0.2)\",\"blur\":10,\"spread\":5},\"reflection\":{\"enabled\":true,\"opacity\":0.1,\"blur\":2},\"parallax\":{\"enabled\":true,\"intensity\":0.1,\"perspective\":1000}}")
  performance             Json?    @default("{\"enableHardwareAcceleration\":true,\"useRAF\":true,\"batchUpdates\":true,\"throttleMs\":16}")
  states                  Json?    @default("{\"hover\":{\"scale\":1.02,\"rotate\":true,\"lift\":true,\"duration\":200,\"easing\":\"cubic-bezier(0.4,0,0.2,1)\"},\"active\":{\"scale\":0.98,\"brightness\":0.95},\"disabled\":{\"opacity\":0.5,\"grayscale\":true}}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Video {
  id             String             @id @default(cuid())
  name           String
  description    String?
  path           String             @unique
  folderId       String
  folder         Folder             @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  visualConfigId String?            @unique
  visualConfig   VideoVisualConfig? @relation(fields: [visualConfigId], references: [id])
}

