// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  path      String   @unique
  isWatched Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  images    Image[]
}

model Image {
  id          String       @id @default(cuid())
  name        String
  path        String       @unique
  size        Int
  hash        String       @unique
  metadata    String?      // JSON string for metadata
  thumbnail   String?      // base64 encoded thumbnail
  folderId    String
  folder      Folder       @relation(fields: [folderId], references: [id])
  collections Collection[] @relation("CollectionToImage")
  tags        Tag[]        @relation("TagToImage")
  favorites   Favorite[]
  stats       ImageStats?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([folderId])
}

model Tag {
  id          String    @id @default(cuid())
  name        String    @unique
  color       String    @default("#3b82f6")
  description String?
  shortcut    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  images      Image[]   @relation("TagToImage")

  @@index([name])
}

model Collection {
  id          String    @id @default(cuid())
  name        String    @unique
  emoji       String    @default("🌟")
  description String?
  color       String    @default("#3b82f6")
  shortcut    String?
  sortBy      String    @default("name")
  filters     String    @default("[]") // JSON string for filters
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  images      Image[]   @relation("CollectionToImage")

  @@index([name])
}

model Favorite {
  id        String   @id @default(cuid())
  imageId   String
  image     Image    @relation(fields: [imageId], references: [id])
  createdAt DateTime @default(now())

  @@index([imageId])
}

model ImageStats {
  id         String   @id @default(cuid())
  imageId    String   @unique
  image      Image    @relation(fields: [imageId], references: [id])
  views      Int      @default(0)
  downloads  Int      @default(0)
  lastViewed DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([imageId])
}

model Profile {
  id            String   @id @default(cuid())
  name          String
  emoji         String   @default("👤")
  color         String   @default("#3b82f6")
  theme         String   @default("system")
  language      String   @default("es")
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
