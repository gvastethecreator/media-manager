// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Folder {
  id          String    @id @default(cuid())
  name        String
  path        String    @unique
  isWatched   Boolean   @default(false)
  totalFiles  Int       @default(0)
  totalSize   Int       @default(0)
  lastIndexed DateTime? @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  images      Image[]

  @@index([path])
  @@index([lastIndexed])
  @@index([createdAt])
}

model Image {
  id                   String       @id @default(cuid())
  hash                 String
  name                 String
  path                 String
  size                 Int
  width                Int
  height               Int
  metadata             String?
  thumbnail            Bytes?
  thumbnailSize        Int?
  thumbnailWidth       Int?
  thumbnailHeight      Int?
  thumbnailError       String?
  thumbnailErrorAt     DateTime?
  thumbnailOptimizedAt DateTime?
  isPublic             Boolean      @default(false)
  isFavorite           Boolean      @default(false)
  folderId             String
  folder               Folder       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  collections          Collection[] @relation("ImageToCollection")
  tags                 Tag[]        @relation("ImageToTag")
  favorites            Favorite[]
  stats                ImageStats?

  @@unique([path, folderId], name: "path_folderId")
  @@index([folderId])
  @@index([hash])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([isPublic])
  @@index([isFavorite])
}

model Tag {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String   @default("#3b82f6")
  description String?
  shortcut    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  images      Image[]  @relation("ImageToTag")

  @@index([name])
  @@index([createdAt])
}

model Collection {
  id          String   @id @default(cuid())
  name        String   @unique
  emoji       String   @default("🌟")
  description String?
  color       String   @default("#3b82f6")
  shortcut    String?
  sortBy      String   @default("name")
  filters     String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  images      Image[]  @relation("ImageToCollection")

  @@index([name])
  @@index([createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  imageId   String
  image     Image    @relation(fields: [imageId], references: [id])
  createdAt DateTime @default(now())

  @@index([imageId])
}

model ImageStats {
  id         String   @id @default(cuid())
  imageId    String   @unique
  image      Image    @relation(fields: [imageId], references: [id])
  views      Int      @default(0)
  downloads  Int      @default(0)
  lastViewed DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([imageId])
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  emoji     String   @default("👤")
  color     String   @default("#3b82f6")
  theme     String   @default("system")
  language  String   @default("es")
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modelo para el sistema de colas
model QueueJob {
  id          String    @id @default(cuid())
  queue       String
  data        String
  status      String    @default("pending")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  error       String?
  progress    Int       @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  priority    Int       @default(0)
  metadata    String?
  retryAt     DateTime?

  @@index([queue, status])
  @@index([status, createdAt])
  @@index([priority, status, createdAt])
  @@index([retryAt])
}
