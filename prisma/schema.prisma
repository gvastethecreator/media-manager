// Modelo para configuración de la parte trasera de tarjetas
model BacksideConfig {
  id         String  @id @default(cuid())
  entityType String
  entityId   String?
  isDefault  Boolean @default(false)
  enabled    Boolean @default(true)

  // Diseño y estilo
  layoutType     String  @default("standard") // standard, tabbed, grid, minimal
  colorMode      String  @default("inherit") // inherit, custom, reverse, contrast
  customColor    String?
  opacity        Float   @default(0.95)
  blurBackground Boolean @default(true)
  blurAmount     Float   @default(10)

  // Contenido
  showAttributes       Boolean @default(true)
  showDescription      Boolean @default(true)
  showStats            Boolean @default(true)
  showMetadata         Boolean @default(true)
  showRelations        Boolean @default(false)
  attributesConfig     String? @default("{}") // JSON para configurar atributos visibles
  maxDescriptionLength Int?    @default(300)

  // Interacción
  flipAnimation  String  @default("rotate") // rotate, fade, flip3d, slide
  flipDuration   Int     @default(600)
  enableAutoFlip Boolean @default(false)
  autoFlipDelay  Int     @default(3000)
  flipTrigger    String  @default("click") // click, hover, doubleClick

  // Propiedades avanzadas
  customBackgroundImage String?
  customTemplate        String?

  // Estilo de UI
  headingStyle   String @default("default") // default, large, subtle, accent
  infoStyle      String @default("default") // default, pills, cards, minimal
  separatorStyle String @default("line") // line, dotted, gradient, none

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación con CardConfiguration
  cardConfiguration CardConfiguration?

  @@unique([entityType, entityId], name: "backside_entity")
  @@index([entityType, isDefault])
}

// Modelo para configuración de Core de tarjetas
model CoreConfig {
  id         String  @id @default(cuid())
  entityType String
  entityId   String?
  isDefault  Boolean @default(false)

  // Sistema de capas
  layerSystem String? @default("default_layer_system") // Simplificando para evitar problemas con JSON

  // Interactividad
  interactiveMode  String  @default("hover") // hover, click, none
  hoverDelay       Int     @default(100)
  touchBehavior    String  @default("tap") // tap, longPress, doubleTap
  pointerPrecision String  @default("medium") // low, medium, high
  motionReduction  Boolean @default(false)

  // Rendimiento
  performanceMode  String  @default("balanced") // performance, balanced, quality
  enableCache      Boolean @default(true)
  loadingStrategy  String  @default("progressive") // eager, lazy, progressive
  enablePreloading Boolean @default(true)

  // Feedback y Respuesta
  enableHaptics   Boolean @default(false)
  hapticIntensity Float   @default(0.5)
  enableSounds    Boolean @default(false)
  soundVolume     Float   @default(0.5)
  soundTheme      String  @default("minimal")

  // Contenido
  contentArrangement String  @default("standard") // standard, compact, expanded, minimal
  enableAutoHeight   Boolean @default(true)
  maxLines           Int?
  textTruncation     String  @default("ellipsis") // ellipsis, fade, scroll
  mediaFit           String  @default("cover") // cover, contain, fill

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación con CardConfiguration
  cardConfiguration CardConfiguration?

  @@unique([entityType, entityId], name: "core_entity")
  @@index([entityType, isDefault])
}

// Modelo para presets visuales
model VisualPreset {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  category    String   @default("general")
  isDefault   Boolean  @default(false)
  isPublic    Boolean  @default(true)
  version     String   @default("1.0.0")
  author      String?
  tags        String   @default("empty_array")
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Configuraciones base serializadas como string - simplificadas para evitar problemas
  coreConfig        String? @default("default_core_config")
  designConfig      String? @default("default_design_config")
  animationConfig   String? @default("default_animation_config")
  layerConfig       String? @default("default_layer_config")
  backsideConfig    String? @default("default_backside_config")
  effectsConfig     String? @default("default_effects_config")
  performanceConfig String? @default("default_performance_config")

  // Configuraciones comunes para todos los layouts - simplificadas
  colorConfig      String? @default("default_color_config")
  imageGridConfig  String? @default("default_image_grid_config")
  layoutConfig     String? @default("default_layout_config")
  explodeConfig    String? @default("default_explode_config")
  previewConfig    String? @default("default_preview_config")
  rarityConfig     String? @default("default_rarity_config")
  validationConfig String? @default("default_validation_config")

  // Estilo Magic Card común - simplificado
  magicCardBase String? @default("default_magic_card_config")

  // Configuraciones específicas por tipo de entidad - simplificadas
  folderConfig     String? @default("default_folder_config")
  imageConfig      String? @default("default_image_config")
  videoConfig      String? @default("default_video_config")
  albumConfig      String? @default("default_album_config")
  tagConfig        String? @default("default_tag_config")
  collectionConfig String? @default("default_collection_config")
  characterConfig  String? @default("default_character_config")
  placeConfig      String? @default("default_place_config")
  worldItemConfig  String? @default("default_world_item_config")
  conceptConfig    String? @default("default_concept_config")
  promptConfig     String? @default("default_prompt_config")
  noteConfig       String? @default("default_note_config")

  // Relaciones con entidades
  folders     Folder[]
  images      Image[]
  videos      Video[]
  characters  Character[]
  places      Place[]
  worldItems  WorldItem[]
  concepts    Concept[]
  prompts     Prompt[]
  notes       Note[]
  albums      Album[]
  tagItems    Tag[]        @relation("TagToVisualPreset")
  collections Collection[]

  // Relaciones con configuraciones visuales
  folderVisualConfigs FolderVisualConfig[]
  imageVisualConfigs  ImageVisualConfig[]
  videoVisualConfigs  VideoVisualConfig[]
  cardConfigurations  CardConfiguration[]

  @@index([name])
  @@index([category])
  @@index([isDefault])
  @@index([isPublic])
}

