// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Modelo para el sistema de colas
model QueueJob {
  id          String    @id @default(cuid())
  queue       String
  data        String
  status      String    @default("pending")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  error       String?
  progress    Int       @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  priority    Int       @default(0)
  metadata    String?
  retryAt     DateTime?

  @@index([queue, status])
  @@index([status, createdAt])
  @@index([priority, status, createdAt])
  @@index([retryAt])
}

// Modelo para el perfil de usuario ( separar en otra db para el futuro)
model Profile {
  id          String   @id @default(cuid())
  name        String
  emoji       String   @default("👤")
  color       String   @default("#3b82f6")
  theme       String   @default("system")
  language    String   @default("es")
  description String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Modelo para las carpetas
model Folder {
  id            String    @id @default(cuid())
  name          String
  path          String    @unique
  totalFiles    Int       @default(0)
  totalSize     Int       @default(0)
  lastIndexed   DateTime? @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  autoReindex   Boolean   @default(false)
  images        Image[]
  featuredImage String?
  isFavorite    Boolean   @default(false)

  @@index([path])
  @@index([lastIndexed])
  @@index([createdAt])
}

// Modelo para las imágenes
model Image {
  id                   String       @id @default(cuid())
  hash                 String
  name                 String
  path                 String
  size                 Int
  width                Int
  height               Int
  metadata             String?
  thumbnail            Bytes?
  thumbnailSize        Int?
  thumbnailWidth       Int?
  thumbnailHeight      Int?
  thumbnailError       String?
  thumbnailErrorAt     DateTime?
  thumbnailOptimizedAt DateTime?
  isPublic             Boolean      @default(false)
  isFavorite           Boolean      @default(false)
  folderId             String
  folder               Folder       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  collections          Collection[] @relation("ImageToCollection")
  tags                 Tag[]        @relation("ImageToTag")
  activities           Activity[]
  stats                ImageStats?
  albums               Album[]      @relation("ImageToAlbum")
  characters           Character[]  @relation("ImageToCharacter")
  places               Place[]      @relation("ImageToPlace")
  worldItems           WorldItem[]  @relation("ImageToWorldItem")

  @@unique([path, folderId], name: "path_folderId")
  @@index([folderId])
  @@index([hash])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([isPublic])
  @@index([isFavorite])
}

// Modelo para las estadísticas de las imágenes
model ImageStats {
  id         String   @id @default(cuid())
  imageId    String   @unique
  image      Image    @relation(fields: [imageId], references: [id])
  views      Int      @default(0)
  downloads  Int      @default(0)
  lastViewed DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([imageId])
}

// Modelo para las actividades de las imágenes
model Activity {
  id          String   @id @default(cuid())
  type        String
  description String
  imageId     String?
  image       Image?   @relation(fields: [imageId], references: [id])
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([imageId])
}

// Modelo para las imágenes subidas
model UploadedImage {
  id        String   @id @default(cuid())
  name      String
  path      String   @unique
  type      String   @default("icon")
  category  String   @default("system")
  size      Int
  width     Int
  height    Int
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([createdAt])
}

// Entidades generales

// Modelo para los álbumes

model Album {
  id          String   @id @default(cuid())
  name        String   @unique
  emoji       String   @default("📸")
  description String?
  color       String   @default("#3b82f6")
  shortcut    String?
  sortBy      String   @default("name")
  filters     String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  images      Image[]  @relation("ImageToAlbum")
  category    String?
  rarity      String?  @default("common")
  texture     String?

  @@index([name])
  @@index([createdAt])
  @@index([rarity])
  @@index([category])
}

model Tag {
  id            String   @id @default(cuid())
  name          String   @unique
  emoji         String   @default("🏷️")
  color         String   @default("#3b82f6")
  description   String?
  shortcut      String?
  featuredImage String?
  isFavorite    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  images        Image[]  @relation("ImageToTag")
  category      String?
  rarity        String?  @default("common")
  texture       String?

  @@index([name])
  @@index([createdAt])
  @@index([rarity])
  @@index([category])
}

model Collection {
  id             String   @id @default(cuid())
  name           String   @unique
  emoji          String   @default("🌟")
  description    String?
  color          String   @default("#3b82f6")
  shortcut       String?
  sortBy         String   @default("name")
  filters        String   @default("[]")
  url            String?
  alternativeUrl String?
  sourceImage    String?
  platform       String?
  price          Float?
  editions       String   @default("[]")
  featuredImage  String?
  isFavorite     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  images         Image[]  @relation("ImageToCollection")
  category       String?
  rarity         String?  @default("common")
  texture        String?

  @@index([name])
  @@index([createdAt])
  @@index([rarity])
  @@index([category])
}

// Modelo para los personajes
model Character {
  id                   String      @id @default(cuid())
  name                 String      @unique
  emoji                String      @default("👤")
  color                String      @default("#3b82f6")
  description          String?
  shortcut             String?
  level                Int         @default(1)
  class                String      @default("unknown")
  race                 String      @default("unknown")
  alignment            String      @default("neutral")
  backstory            String      @default("")
  stats                String      @default("{}")
  sortBy               String      @default("name")
  filters              String      @default("[]")
  psychologicalProfile String      @default("")
  socialProfile        String      @default("")
  relationships        String      @default("[]")
  goals                String      @default("[]")
  fears                String      @default("[]")
  beliefs              String      @default("[]")
  personality          String      @default("[]")
  featuredImage        String?
  isFavorite           Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  images               Image[]     @relation("ImageToCharacter")
  relatedCharacters    Character[] @relation("CharacterRelations")
  relatedTo            Character[] @relation("CharacterRelations")
  notes                Note[]      @relation("CharacterToNote")
  concepts             Concept[]   @relation("CharacterToConcept")
  prompts              Prompt[]    @relation("CharacterToPrompt")
  category             String?

  @@index([name])
  @@index([createdAt])
  @@index([class])
  @@index([race])
}

// Modelo para los lugares
model Place {
  id            String    @id @default(cuid())
  name          String    @unique
  emoji         String    @default("📍")
  color         String    @default("#3b82f6")
  description   String?
  shortcut      String?
  region        String    @default("unknown")
  type          String    @default("unknown")
  climate       String    @default("temperate")
  population    Int       @default(0)
  government    String    @default("unknown")
  dangers       String    @default("[]")
  resources     String    @default("[]")
  lore          String    @default("")
  history       String    @default("")
  stats         String    @default("{}")
  sortBy        String    @default("name")
  filters       String    @default("[]")
  featuredImage String?
  isFavorite    Boolean   @default(false)
  notes         Note[]    @relation("PlaceToNote")
  concepts      Concept[] @relation("PlaceToConcept")
  prompts       Prompt[]  @relation("PlaceToPrompt")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  images        Image[]   @relation("ImageToPlace")
  category      String?

  @@index([name])
  @@index([createdAt])
  @@index([type])
  @@index([climate])
  @@index([region])
}

// Modelo para los objetos del mundo
model WorldItem {
  id            String    @id @default(cuid())
  name          String    @unique
  emoji         String    @default("🎯")
  color         String    @default("#3b82f6")
  description   String?
  shortcut      String?
  type          String    @default("misc")
  rarity        String    @default("common")
  properties    String    @default("[]")
  requirements  String    @default("{}")
  origin        String    @default("")
  stats         String    @default("{}")
  sortBy        String    @default("name")
  filters       String    @default("[]")
  featuredImage String?
  isFavorite    Boolean   @default(false)
  notes         Note[]    @relation("WorldItemToNote")
  concepts      Concept[] @relation("WorldItemToConcept")
  prompts       Prompt[]  @relation("WorldItemToPrompt")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  images        Image[]   @relation("ImageToWorldItem")
  category      String?

  @@index([name])
  @@index([createdAt])
  @@index([type])
  @@index([rarity])
}

// Modelo para los conceptos
model Concept {
  id            String      @id @default(cuid())
  name          String      @unique
  emoji         String      @default("💡")
  color         String      @default("#3b82f6")
  description   String?
  content       String      @default("")
  category      String      @default("general")
  tags          String      @default("[]")
  featuredImage String?
  isFavorite    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  characters    Character[] @relation("CharacterToConcept")
  places        Place[]     @relation("PlaceToConcept")
  worldItems    WorldItem[] @relation("WorldItemToConcept")
  notes         Note[]      @relation("ConceptToNote")
  prompts       Prompt[]    @relation("ConceptToPrompt")

  @@index([name])
  @@index([category])
  @@index([createdAt])
}

// Modelo para los prompts
model Prompt {
  id            String      @id @default(cuid())
  name          String      @unique
  emoji         String      @default("🎯")
  color         String      @default("#3b82f6")
  description   String?
  content       String      @default("")
  category      String      @default("general")
  parameters    String      @default("{}")
  tags          String      @default("[]")
  featuredImage String?
  isFavorite    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  characters    Character[] @relation("CharacterToPrompt")
  places        Place[]     @relation("PlaceToPrompt")
  worldItems    WorldItem[] @relation("WorldItemToPrompt")
  concepts      Concept[]   @relation("ConceptToPrompt")
  notes         Note[]      @relation("PromptToNote")

  @@index([name])
  @@index([category])
  @@index([createdAt])
}

// Modelo para las notas
model Note {
  id            String      @id @default(cuid())
  title         String
  content       String      @default("")
  category      String      @default("general")
  priority      Int         @default(0)
  status        String      @default("active")
  tags          String      @default("[]")
  featuredImage String?
  isFavorite    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  characters    Character[] @relation("CharacterToNote")
  places        Place[]     @relation("PlaceToNote")
  worldItems    WorldItem[] @relation("WorldItemToNote")
  concepts      Concept[]   @relation("ConceptToNote")
  prompts       Prompt[]    @relation("PromptToNote")

  @@index([title])
  @@index([category])
  @@index([priority])
  @@index([status])
  @@index([createdAt])
}

// Modelo para configuración de tarjetas de entidades
model CardConfiguration {
  id                      String  @id @default(cuid())
  entityType              String  @unique
  enable3DEffect          Boolean @default(true)
  enableHolographicEffect Boolean @default(true)
  enableScanlines         Boolean @default(true)
  enableLightHalo         Boolean @default(true)
  enableAnimatedBorder    Boolean @default(true)
  enableGlowEffect        Boolean @default(true)
  enableGrainEffect       Boolean @default(true)
  hoverLiftHeight         Int     @default(10)
  maxRotation             Int     @default(15)
  primaryColor            String  @default("#3b82f6")
  secondaryColor          String  @default("#8b5cf6")
  raritySystem            Boolean @default(false)
  categorySystem          Boolean @default(true)
  textureSystem           Boolean @default(false)

  // Nuevos campos para configuraciones extendidas
  holographicOptions String? @default("{\"intensity\":1,\"animationSpeed\":1,\"patternType\":\"rainbow\",\"visibleOnHover\":true}")
  scanlinesOptions   String? @default("{\"opacity\":0.2,\"spacing\":4,\"direction\":\"horizontal\",\"animate\":false,\"visibleOnHover\":false}")
  glowOptions        String? @default("{\"intensity\":1,\"size\":100,\"blurAmount\":30,\"animationType\":\"follow-mouse\",\"pulseSpeed\":1.5,\"visibleOnHover\":true}")
  borderOptions      String? @default("{\"width\":2,\"pattern\":\"solid\",\"animationType\":\"flow\",\"animationSpeed\":1,\"animationDuration\":6,\"glowIntensity\":5,\"glowOnHover\":true}")
  grainOptions       String? @default("{\"intensity\":0.15,\"density\":0.6,\"contrast\":1.2,\"noise\":\"light\",\"animated\":false,\"animationSpeed\":1,\"visibleOnHover\":true}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType])
}

// Modelo para rarezas
model Rarity {
  id              String   @id @default(cuid())
  entityType      String
  name            String
  color           String   @default("#3b82f6")
  borderEffect    String?
  borderWidth     Float?   @default(2)
  borderPattern   String?  @default("solid")
  borderAnimation String?  @default("none")
  glowColor       String?
  glowIntensity   Float?   @default(5)
  glowSize        Float?   @default(100)
  glowAnimation   String?  @default("none")
  badgeClass      String?
  barClass        String?
  description     String?
  position        Int      @default(0) // Para el orden de rarezas
  chance          Float    @default(0) // Porcentaje de probabilidad (0-100)
  unlockCondition String? // Condición para desbloquear esta rareza
  specialEffects  String?  @default("{}") // JSON para efectos especiales adicionales
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([entityType, name])
  @@index([entityType])
}

// Modelo para texturas
model Texture {
  id             String   @id @default(cuid())
  entityType     String
  name           String
  imageUrl       String?
  patternType    String?
  color          String   @default("#3b82f6")
  opacity        Float    @default(0.5)
  description    String?
  blendMode      String?  @default("overlay")
  noiseType      String?  @default("light")
  animated       Boolean  @default(false)
  animationSpeed Float?   @default(1)
  density        Float?   @default(0.6)
  contrast       Float?   @default(1.2)
  visibleOnHover Boolean  @default(false)
  layerOrder     Int      @default(6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([entityType, name])
  @@index([entityType])
}
