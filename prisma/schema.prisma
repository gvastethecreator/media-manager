// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider              = "prisma-client-js"
  output                = "../node_modules/.prisma/client"
  binaryTargets         = ["native"]
  generateBrowserClient = false
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Modelo para el sistema de colas
model QueueJob {
  id          String    @id @default(cuid())
  queue       String
  data        String
  status      String    @default("pending")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  error       String?
  progress    Int       @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  priority    Int       @default(0)
  metadata    String?
  retryAt     DateTime?

  @@index([queue, status])
  @@index([status, createdAt])
  @@index([priority, status, createdAt])
  @@index([retryAt])
}

// Modelo para el perfil de usuario
model Profile {
  // Identificación
  id   String @id @default(cuid())
  name String

  // Apariencia
  emoji String @default("👤")
  color String @default("#3b82f6")

  // Contenido
  description String?
  isActive    Boolean @default(false)

  // Relaciones
  settings      Settings?  @relation(fields: [settingsId], references: [id])
  featuredImage Image?     @relation(fields: [imageId], references: [id])
  favorites     Favorite[] // Relación con favoritos

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  settingsId String?
  imageId    String?
}

// Settings para el sistema
model Settings {
  // Identificación
  id String @id @default(cuid())

  // Configuración
  theme    String @default("system")
  language String @default("es")
  /// Datos de configuración serializados
  data     Json

  // Relaciones
  Profile Profile[]

  // Foreign keys
  profileId String @unique
}

// Modelo para las carpetas
model Folder {
  // Identificación
  id   String @id @default(cuid())
  name String

  // Contenido
  description String?
  path        String  @unique

  // Propiedades de visualización
  emoji         String? @default("📁")
  color         String? @default("#3b82f6")
  featuredImage String?
  isFavorite    Boolean @default(false)

  // Propiedades de sistema
  totalFiles  Int       @default(0)
  totalSize   Int       @default(0)
  autoReindex Boolean   @default(false)
  lastIndexed DateTime? @default(now())

  // Relaciones
  parent   Folder?  @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderToFolder")
  images   Image[]
  videos   Video[]

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  parentId String?
  presetId String?

  @@index([path])
  @@index([lastIndexed])
  @@index([createdAt])
}

// Modelo para las imágenes
model Image {
  // Identificación
  id   String @id @default(cuid())
  name String

  // Contenido básico
  description String?
  path        String  @unique
  hash        String

  // Propiedades técnicas
  size     Int
  width    Int
  height   Int
  metadata String?

  // Propiedades para thumbnail
  thumbnail            Bytes?
  thumbnailSize        Int?
  thumbnailWidth       Int?
  thumbnailHeight      Int?
  thumbnailMimeType    String?
  thumbnailError       String?
  thumbnailErrorAt     DateTime?
  thumbnailOptimizedAt DateTime?

  // Estado
  isFavorite Boolean @default(false)

  // Relaciones básicas
  folder         Folder          @relation(fields: [folderId], references: [id], onDelete: Cascade)
  stats          ImageStats?
  activities     Activity[]
  uploadedImages UploadedImage[]
  profiles       Profile[]

  // Relaciones con entidades principales
  albums      Album[]      @relation("ImageToAlbum")
  collections Collection[] @relation("ImageToCollection")
  tags        Tag[]        @relation("ImageToTag")
  characters  Character[]  @relation("ImageToCharacter")
  places      Place[]      @relation("ImageToPlace")
  worldItems  WorldItem[]  @relation("ImageToWorldItem")
  concepts    Concept[]    @relation("ImageToConcept")
  prompts     Prompt[]     @relation("ImageToPrompt")
  notes       Note[]       @relation("ImageToNote")
  wildcards   Wildcard[]   @relation("ImageToWildcard")
  properties  Property[]   @relation("ImageToProperty")
  groups      Group[]      @relation("ImageToGroup")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  addedAt   DateTime @default(now())

  // Foreign keys
  folderId String
  noteId   String?

  @@unique([path, folderId], name: "path_folderId")
  @@index([folderId])
  @@index([hash])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([isFavorite])
}

// Modelo para los videos
model Video {
  // Identificación
  id   String @id @default(cuid())
  name String

  // Contenido básico
  description String?
  path        String  @unique
  hash        String

  // Propiedades técnicas
  size     Int
  duration Int
  width    Int?
  height   Int?
  metadata String?

  // Propiedades para thumbnail
  thumbnail       Bytes?
  thumbnailSize   Int?
  thumbnailWidth  Int?
  thumbnailHeight Int?

  // Estado
  isPublic   Boolean @default(false)
  isFavorite Boolean @default(false)

  // Relaciones
  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  // Relaciones con entidades principales
  albums      Album[]      @relation("VideoToAlbum")
  collections Collection[] @relation("VideoToCollection")
  tags        Tag[]        @relation("VideoToTag")
  characters  Character[]  @relation("VideoToCharacter")
  places      Place[]      @relation("VideoToPlace")
  worldItems  WorldItem[]  @relation("VideoToWorldItem")
  concepts    Concept[]    @relation("VideoToConcept")
  prompts     Prompt[]     @relation("VideoToPrompt")
  notes       Note[]       @relation("VideoToNote")
  wildcards   Wildcard[]   @relation("VideoToWildcard")
  properties  Property[]   @relation("VideoToProperty")
  groups      Group[]      @relation("VideoToGroup")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  folderId String

  @@index([folderId])
  @@index([hash])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([isPublic])
  @@index([isFavorite])
}

// Modelo para las imágenes subidas
model UploadedImage {
  // Identificación
  id   String @id @default(cuid())
  name String

  // Contenido
  path     String @unique
  category String @default("system")
  type     String @default("image")

  // Propiedades técnicas
  size     Int
  width    Int
  height   Int
  metadata String?
  hash     String

  // Relaciones
  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  uploadedAt DateTime @default(now())

  // Foreign keys
  imageId String

  @@index([category])
  @@index([createdAt])
  @@index([imageId])
}

// Modelo para las estadísticas de las imágenes
model ImageStats {
  // Identificación
  id String @id @default(cuid())

  // Estadísticas
  views      Int      @default(0)
  lastViewed DateTime @default(now())

  // Relaciones
  image Image @relation(fields: [imageId], references: [id])

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  imageId String @unique

  @@index([imageId])
}

// Modelo para las actividades
model Activity {
  // Identificación
  id String @id @default(cuid())

  // Contenido
  type        String
  description String

  // Relaciones
  image Image? @relation(fields: [imageId], references: [id])

  // Metadata
  createdAt  DateTime @default(now())
  modifiedAt DateTime @updatedAt
  addedAt    DateTime @default(now())

  // Foreign keys
  imageId String?

  @@index([createdAt])
  @@index([imageId])
}

// --------- ENTIDADES PRINCIPALES ---------

// Modelo para los grupos
model Group {
  // Identificación
  id   String @id @default(cuid())
  name String @unique

  // Apariencia
  emoji String @default("📂")
  color String @default("#3b82f6")

  // Contenido
  description String?
  shortcut    String?
  category    String? @default("general")

  // Configuración
  sortBy  String @default("name")
  filters String @default("[]")

  // Propiedades de visualización
  featuredImage String?
  isFavorite    Boolean @default(false)

  // Relaciones con entidades principales
  images      Image[]      @relation("ImageToGroup")
  videos      Video[]      @relation("VideoToGroup")
  albums      Album[]      @relation("GroupToAlbum")
  collections Collection[] @relation("GroupToCollection")
  tags        Tag[]        @relation("GroupToTag")
  characters  Character[]  @relation("GroupToCharacter")
  places      Place[]      @relation("GroupToPlace")
  worldItems  WorldItem[]  @relation("GroupToWorldItem")
  concepts    Concept[]    @relation("GroupToConcept")
  prompts     Prompt[]     @relation("GroupToPrompt")
  notes       Note[]       @relation("GroupToNote")
  wildcards   Wildcard[]   @relation("GroupToWildcard")
  properties  Property[]   @relation("GroupToProperty")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([createdAt])
  @@index([category])
}

// Modelo para los álbumes
model Album {
  // Identificación
  id   String @id @default(cuid())
  name String @unique

  // Apariencia
  emoji String @default("📸")
  color String @default("#3b82f6")

  // Contenido
  description String?
  shortcut    String?
  category    String? @default("general")

  // Configuración
  sortBy  String @default("name")
  filters String @default("[]")

  // Propiedades de visualización
  featuredImage String?
  isFavorite    Boolean @default(false)

  // Relaciones con contenido
  images Image[] @relation("ImageToAlbum")
  videos Video[] @relation("VideoToAlbum")

  // Relaciones con entidades principales
  collections Collection[] @relation("AlbumToCollection")
  tags        Tag[]        @relation("AlbumToTag")
  characters  Character[]  @relation("AlbumToCharacter")
  places      Place[]      @relation("AlbumToPlace")
  worldItems  WorldItem[]  @relation("AlbumToWorldItem")
  concepts    Concept[]    @relation("AlbumToConcept")
  prompts     Prompt[]     @relation("AlbumToPrompt")
  notes       Note[]       @relation("AlbumToNote")
  wildcards   Wildcard[]   @relation("AlbumToWildcard")
  properties  Property[]   @relation("AlbumToProperty")
  groups      Group[]      @relation("GroupToAlbum")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([createdAt])
  @@index([category])
}

// Modelo para las colecciones
model Collection {
  // Identificación
  id   String @id @default(cuid())
  name String @unique

  // Apariencia
  emoji String @default("🌟")
  color String @default("#3b82f6")

  // Contenido
  description String?
  shortcut    String?
  category    String? @default("general")

  // Configuración
  sortBy  String @default("name")
  filters String @default("[]")

  // Propiedades externas
  url             String?
  alternativeUrl  String?
  sourceImage     String?
  platform        String?
  price           Float?
  network         String?
  tokenId         String?
  tokenAddress    String?
  contractAddress String?
  contractType    String?
  editions        String  @default("[]")

  // Propiedades de visualización
  featuredImage String?
  isFavorite    Boolean @default(false)

  // Relaciones con contenido
  images Image[] @relation("ImageToCollection")
  videos Video[] @relation("VideoToCollection")

  // Relaciones con entidades principales
  albums     Album[]     @relation("AlbumToCollection")
  tags       Tag[]       @relation("CollectionToTag")
  characters Character[] @relation("CollectionToCharacter")
  places     Place[]     @relation("CollectionToPlace")
  worldItems WorldItem[] @relation("CollectionToWorldItem")
  concepts   Concept[]   @relation("CollectionToConcept")
  prompts    Prompt[]    @relation("CollectionToPrompt")
  notes      Note[]      @relation("CollectionToNote")
  wildcards  Wildcard[]  @relation("CollectionToWildcard")
  properties Property[]  @relation("CollectionToProperty")
  groups     Group[]     @relation("GroupToCollection")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([createdAt])
  @@index([category])
}

// Modelo para las etiquetas
model Tag {
  // Identificación
  id   String @id @default(cuid())
  name String @unique

  // Apariencia
  emoji String @default("🏷️")
  color String @default("#3b82f6")

  // Contenido
  description String?
  shortcut    String?
  category    String? @default("general")

  // Propiedades de visualización
  featuredImage String?
  isFavorite    Boolean @default(false)

  // Relaciones con contenido
  images Image[] @relation("ImageToTag")
  videos Video[] @relation("VideoToTag")

  // Relaciones con entidades principales
  albums      Album[]      @relation("AlbumToTag")
  collections Collection[] @relation("CollectionToTag")
  characters  Character[]  @relation("TagToCharacter")
  places      Place[]      @relation("TagToPlace")
  worldItems  WorldItem[]  @relation("TagToWorldItem")
  concepts    Concept[]    @relation("TagToConcept")
  prompts     Prompt[]     @relation("TagToPrompt")
  notes       Note[]       @relation("TagToNote")
  wildcards   Wildcard[]   @relation("TagToWildcard")
  properties  Property[]   @relation("TagToProperty")
  groups      Group[]      @relation("GroupToTag")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([createdAt])
  @@index([category])
}

// Modelo para las propiedades
model Property {
  // Identificación
  id   String @id @default(cuid())
  name String @unique

  // Apariencia
  emoji String @default("🔍")
  color String @default("#3b82f6")

  // Contenido
  description String?
  shortcut    String?
  category    String? @default("general")

  // Propiedades de visualización
  featuredImage String?
  isFavorite    Boolean @default(false)

  // Relaciones con contenido
  images Image[] @relation("ImageToProperty")
  videos Video[] @relation("VideoToProperty")

  // Relaciones con entidades principales
  albums      Album[]      @relation("AlbumToProperty")
  collections Collection[] @relation("CollectionToProperty")
  tags        Tag[]        @relation("TagToProperty")
  characters  Character[]  @relation("PropertyToCharacter")
  places      Place[]      @relation("PropertyToPlace")
  worldItems  WorldItem[]  @relation("PropertyToWorldItem")
  concepts    Concept[]    @relation("PropertyToConcept")
  prompts     Prompt[]     @relation("PropertyToPrompt")
  notes       Note[]       @relation("PropertyToNote")
  wildcards   Wildcard[]   @relation("PropertyToWildcard")
  groups      Group[]      @relation("GroupToProperty")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([createdAt])
  @@index([category])
}

// Modelo para comodines
model Wildcard {
  // Identificación
  id   String @id @default(cuid())
  name String @unique

  // Apariencia
  emoji String @default("🎭")
  color String @default("#3b82f6")

  // Contenido
  description String?
  shortcut    String?
  category    String? @default("general")
  children    String  @default("[]")

  // Propiedades de visualización
  featuredImage String?
  isFavorite    Boolean @default(false)

  // Relaciones jerárquicas
  parent         Wildcard?  @relation("WildcardToWildcard", fields: [parentId], references: [id], onDelete: Cascade)
  childWildcards Wildcard[] @relation("WildcardToWildcard")

  // Relaciones con contenido
  images Image[] @relation("ImageToWildcard")
  videos Video[] @relation("VideoToWildcard")

  // Relaciones con entidades principales
  albums      Album[]      @relation("AlbumToWildcard")
  collections Collection[] @relation("CollectionToWildcard")
  tags        Tag[]        @relation("TagToWildcard")
  characters  Character[]  @relation("WildcardToCharacter")
  places      Place[]      @relation("WildcardToPlace")
  worldItems  WorldItem[]  @relation("WildcardToWorldItem")
  concepts    Concept[]    @relation("WildcardToConcept")
  prompts     Prompt[]     @relation("WildcardToPrompt")
  notes       Note[]       @relation("WildcardToNote")
  properties  Property[]   @relation("PropertyToWildcard")
  groups      Group[]      @relation("GroupToWildcard")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  parentId String?

  @@index([name])
  @@index([createdAt])
  @@index([category])
}

// Modelo para los personajes
model Character {
  // Identificación
  id   String @id @default(cuid())
  name String @unique

  // Apariencia
  emoji String @default("👤")
  color String @default("#3b82f6")

  // Contenido básico
  description String?
  shortcut    String?
  category    String? @default("general")

  // Configuración
  sortBy  String @default("name")
  filters String @default("[]")

  // Atributos del personaje
  level     Int     @default(1)
  class     String  @default("unknown")
  race      String  @default("unknown")
  type      String?
  alignment String  @default("neutral")

  // Características detalladas
  backstory            String @default("")
  stats                String @default("")
  psychologicalProfile String @default("")
  socialProfile        String @default("")
  relationships        String @default("[]")
  goals                String @default("[]")
  fears                String @default("[]")
  beliefs              String @default("[]")
  personality          String @default("[]")
  skills               String @default("[]")
  abilities            String @default("[]")

  // Propiedades de visualización
  featuredImage String?
  isFavorite    Boolean @default(false)

  // Relaciones con contenido
  images Image[] @relation("ImageToCharacter")
  videos Video[] @relation("VideoToCharacter")

  // Relaciones con personajes
  relatedCharacters Character[] @relation("CharacterRelations")
  relatedTo         Character[] @relation("CharacterRelations")

  // Relaciones con entidades principales
  albums      Album[]      @relation("AlbumToCharacter")
  collections Collection[] @relation("CollectionToCharacter")
  tags        Tag[]        @relation("TagToCharacter")
  places      Place[]      @relation("CharacterToPlace")
  worldItems  WorldItem[]  @relation("CharacterToWorldItem")
  concepts    Concept[]    @relation("CharacterToConcept")
  prompts     Prompt[]     @relation("CharacterToPrompt")
  notes       Note[]       @relation("CharacterToNote")
  wildcards   Wildcard[]   @relation("WildcardToCharacter")
  properties  Property[]   @relation("PropertyToCharacter")
  groups      Group[]      @relation("GroupToCharacter")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([createdAt])
  @@index([class])
  @@index([race])
  @@index([category])
}

// Modelo para los lugares
model Place {
  // Identificación
  id   String @id @default(cuid())
  name String @unique

  // Apariencia
  emoji String @default("📍")
  color String @default("#3b82f6")

  // Contenido básico
  description String?
  shortcut    String?
  category    String? @default("general")

  // Configuración
  sortBy  String @default("name")
  filters String @default("[]")

  // Atributos del lugar
  region     String @default("unknown")
  type       String @default("unknown")
  climate    String @default("temperate")
  population Int    @default(0)
  government String @default("unknown")

  // Características detalladas
  dangers   String @default("[]")
  resources String @default("[]")
  lore      String @default("")
  history   String @default("")
  stats     String @default("")

  // Propiedades de visualización
  featuredImage String?
  isFavorite    Boolean @default(false)

  // Relaciones con contenido
  images Image[] @relation("ImageToPlace")
  videos Video[] @relation("VideoToPlace")

  // Relaciones con entidades principales
  albums      Album[]      @relation("AlbumToPlace")
  collections Collection[] @relation("CollectionToPlace")
  tags        Tag[]        @relation("TagToPlace")
  characters  Character[]  @relation("CharacterToPlace")
  worldItems  WorldItem[]  @relation("PlaceToWorldItem")
  concepts    Concept[]    @relation("PlaceToConcept")
  prompts     Prompt[]     @relation("PlaceToPrompt")
  notes       Note[]       @relation("PlaceToNote")
  wildcards   Wildcard[]   @relation("WildcardToPlace")
  properties  Property[]   @relation("PropertyToPlace")
  groups      Group[]      @relation("GroupToPlace")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([createdAt])
  @@index([type])
  @@index([climate])
  @@index([region])
  @@index([category])
}

// Modelo para los objetos del mundo
model WorldItem {
  // Identificación
  id   String @id @default(cuid())
  name String @unique

  // Apariencia
  emoji String @default("🎯")
  color String @default("#3b82f6")

  // Contenido básico
  description String?
  shortcut    String?
  category    String? @default("general")

  // Configuración
  sortBy  String @default("name")
  filters String @default("[]")

  // Atributos del objeto
  type       String @default("misc")
  rarity     String @default("common")
  attributes String @default("[]")
  effects    String @default("[]")
  size       String @default("medium")

  // Características detalladas
  requirements String @default("")
  origin       String @default("")
  stats        String @default("")

  // Propiedades de visualización
  featuredImage String?
  isFavorite    Boolean @default(false)

  // Relaciones con contenido
  images Image[] @relation("ImageToWorldItem")
  videos Video[] @relation("VideoToWorldItem")

  // Relaciones con entidades principales
  albums      Album[]      @relation("AlbumToWorldItem")
  collections Collection[] @relation("CollectionToWorldItem")
  tags        Tag[]        @relation("TagToWorldItem")
  characters  Character[]  @relation("CharacterToWorldItem")
  places      Place[]      @relation("PlaceToWorldItem")
  concepts    Concept[]    @relation("WorldItemToConcept")
  prompts     Prompt[]     @relation("WorldItemToPrompt")
  notes       Note[]       @relation("WorldItemToNote")
  wildcards   Wildcard[]   @relation("WildcardToWorldItem")
  properties  Property[]   @relation("PropertyToWorldItem")
  groups      Group[]      @relation("GroupToWorldItem")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([createdAt])
  @@index([type])
  @@index([rarity])
  @@index([category])
}

// Modelo para los conceptos
model Concept {
  // Identificación
  id   String @id @default(cuid())
  name String @unique

  // Apariencia
  emoji String @default("💡")
  color String @default("#3b82f6")

  // Contenido
  description String?
  content     String  @default("")
  category    String  @default("general")

  // Propiedades de visualización
  featuredImage String?
  isFavorite    Boolean @default(false)

  // Relaciones con contenido
  images Image[] @relation("ImageToConcept")
  videos Video[] @relation("VideoToConcept")

  // Relaciones con entidades principales
  albums      Album[]      @relation("AlbumToConcept")
  collections Collection[] @relation("CollectionToConcept")
  tagEntities Tag[]        @relation("TagToConcept") // Renombrado para evitar conflicto
  characters  Character[]  @relation("CharacterToConcept")
  places      Place[]      @relation("PlaceToConcept")
  worldItems  WorldItem[]  @relation("WorldItemToConcept")
  prompts     Prompt[]     @relation("ConceptToPrompt")
  notes       Note[]       @relation("ConceptToNote")
  wildcards   Wildcard[]   @relation("WildcardToConcept")
  properties  Property[]   @relation("PropertyToConcept")
  groups      Group[]      @relation("GroupToConcept")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([category])
  @@index([createdAt])
}

// Modelo para los prompts
model Prompt {
  // Identificación
  id   String @id @default(cuid())
  name String @unique

  // Apariencia
  emoji String @default("🎯")
  color String @default("#3b82f6")

  // Contenido
  description String?
  content     String  @default("")
  purpose     String  @default("")
  category    String  @default("general")
  parameters  String  @default("")
  tags        String  @default("[]") // <--- Campo serializado para arrays
  tagEntities Tag[]   @relation("TagToPrompt") // <--- Relación renombrada

  // Propiedades de visualización
  featuredImage String?
  isFavorite    Boolean @default(false)

  // Relaciones con contenido
  images Image[] @relation("ImageToPrompt")
  videos Video[] @relation("VideoToPrompt")

  // Relaciones con entidades principales
  albums      Album[]      @relation("AlbumToPrompt")
  collections Collection[] @relation("CollectionToPrompt")
  characters  Character[]  @relation("CharacterToPrompt")
  places      Place[]      @relation("PlaceToPrompt")
  worldItems  WorldItem[]  @relation("WorldItemToPrompt")
  concepts    Concept[]    @relation("ConceptToPrompt")
  notes       Note[]       @relation("PromptToNote")
  wildcards   Wildcard[]   @relation("WildcardToPrompt")
  properties  Property[]   @relation("PropertyToPrompt")
  groups      Group[]      @relation("GroupToPrompt")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([category])
  @@index([createdAt])
}

// Modelo para las notas
model Note {
  // Identificación
  id    String @id @default(cuid())
  title String

  // Contenido
  content  String @default("")
  category String @default("general")

  // Propiedades de estado
  priority Int    @default(0)
  status   String @default("active")

  // Propiedades de visualización
  featuredImage String?
  isFavorite    Boolean @default(false)

  // Relaciones con contenido
  images Image[] @relation("ImageToNote")
  videos Video[] @relation("VideoToNote")

  // Relaciones con entidades principales
  albums      Album[]      @relation("AlbumToNote")
  collections Collection[] @relation("CollectionToNote")
  tags        Tag[]        @relation("TagToNote")
  characters  Character[]  @relation("CharacterToNote")
  places      Place[]      @relation("PlaceToNote")
  worldItems  WorldItem[]  @relation("WorldItemToNote")
  concepts    Concept[]    @relation("ConceptToNote")
  prompts     Prompt[]     @relation("PromptToNote")
  wildcards   Wildcard[]   @relation("WildcardToNote")
  properties  Property[]   @relation("PropertyToNote")
  groups      Group[]      @relation("GroupToNote")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  presetId String?

  @@index([title])
  @@index([category])
  @@index([priority])
  @@index([status])
  @@index([createdAt])
}

// =====================
// Nuevas entidades 2025-06-17
// =====================

model Workflow {
  id        String   @id @default(cuid())
  name      String
  filePath  String // Ruta al archivo JSON
  content   String // Contenido JSON (puede ser largo)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id        String   @id @default(cuid())
  name      String
  filePath  String // Ruta al archivo md o txt
  content   String // Contenido del documento
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JsonFile {
  id        String   @id @default(cuid())
  name      String
  filePath  String // Ruta al archivo JSON
  content   String // Contenido JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model File3D {
  id        String   @id @default(cuid())
  name      String
  filePath  String // Ruta al archivo 3D
  format    String // Formato (glb, obj, fbx, etc)
  size      Int // Tamaño en bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Audio {
  id        String   @id @default(cuid())
  name      String
  filePath  String // Ruta al archivo de audio
  format    String // Formato (mp3, wav, flac, etc)
  duration  Int? // Duración en segundos
  size      Int // Tamaño en bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modelo para favoritos - Sistema multi-perfil local
model Favorite {
  // Identificación
  id String @id @default(cuid())

  // Relación con el perfil
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String

  // Entidad favorita
  entityId   String
  entityType String // 'image', 'album', 'character', 'collection', etc.

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Índices para optimización
  @@unique([profileId, entityId, entityType])
  @@index([profileId])
  @@index([entityType])
  @@index([createdAt])
}
