{
  "editor.suggestSelection": "first",
  "vsintellicode.modify.editor.suggestSelection": "enabled",
  "files.exclude": {
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "git.autofetch": true,
  "editor.wordWrap": "on",
  "editor.mouseWheelZoom": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.tabSize": 2,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "editor.smoothScrolling": true,
  "terminal.integrated.mouseWheelScrollSensitivity": 0.7,
  "prettier.useTabs": true,
  "workbench.editor.highlightModifiedTabs": true,
  "gitlens.views.repositories.files.layout": "tree",

  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "smoothtype.duration": 160,
  "gitlens.gitCommands.skipConfirmations": ["fetch:command", "switch:command"],
  "files.autoGuessEncoding": true,
  "editor.inlineSuggest.enabled": true,
  "files.autoSave": "afterDelay",
  "editor.suggest.preview": true,
  "terminal.integrated.fontFamily": "DroidSansMono NFM",
  "terminal.integrated.fontSize": 9,
  "files.trimTrailingWhitespace": true,
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,
  "smoothtype.autoReload": true,
  "files.associations": {
    "*.py": "python"
  },
  "editor.suggest.localityBonus": true,
  "editor.stickyScroll.enabled": true,
  "git.openRepositoryInParentFolders": "never",
  "explorer.confirmDelete": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.fastScrollSensitivity": 10,
  "editor.fontSize": 12,
  "editor.fontFamily": "DroidSansMono NFM",
  "editor.fontVariations": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "typescript.tsserver.useSyntaxServer": "auto",
  "editor.autoClosingComments": "always",
  "window.autoDetectColorScheme": true,
  "extensions.experimental.deferredStartupFinishedActivation": true,
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "workbench.preferredDarkColorTheme": "Bearded Theme Monokai Black",
  "git.enableSmartCommit": true,
  "workbench.activityBar.location": "top",
  "powermode.enabled": true,
  "powermode.presets": "simple-rift",
  "powermode.combo.location": "off",
  "powermode.combo.counterEnabled": "hide",
  "powermode.combo.timerEnabled": "hide",
  "powermode.shake.enabled": false,
  ,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "files.autoSaveDelay": 1000,
  "editor.detectIndentation": true,
  "editor.insertSpaces": false,
  "python.defaultInterpreterPath": "./venv/bin/python",
  "typescript.tsserver.web.projectWideIntellisense.enabled": false,
  "typescript.tsserver.web.typeAcquisition.enabled": false,
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,

  // Configuración específica para ESLint
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "eslint.format.enable": true,
  "eslint.run": "onSave",

  // Configuración específica para Prettier
  "prettier.requireConfig": true,
  "prettier.printWidth": 120,
  "prettier.singleQuote": true,
  "prettier.semi": true,
  "prettier.arrowParens": "always",

  // Configuración Next.js
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  "tailwindCSS.emmetCompletions": true,

  // Formateo al guardar
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,

  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "args": ["-NoProfile"],
      "icon": "terminal-powershell"
    }
  },
  "github.copilot.chat.localeOverride": "es",
  "github.copilot.chat.followUps": "always",
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.chat.editor.temporalContext.enabled": false,
  "github.copilot.chat.edits.temporalContext.enabled": true,
  "github.copilot.chat.languageContext.typescript.enabled": true,
  "github.copilot.chat.generateTests.codeLens": true
}
