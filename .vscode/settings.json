{
  "editor.suggestSelection": "first",
  "vsintellicode.modify.editor.suggestSelection": "enabled",
  "files.exclude": {
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "git.autofetch": true,
  "editor.wordWrap": "on",
  "editor.mouseWheelZoom": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.tabSize": 2,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "editor.smoothScrolling": true,
  "terminal.integrated.mouseWheelScrollSensitivity": 0.7,
  "prettier.useTabs": true,
  "workbench.editor.highlightModifiedTabs": true,
  "gitlens.views.repositories.files.layout": "tree",
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "smoothtype.duration": 160,
  "gitlens.gitCommands.skipConfirmations": ["fetch:command", "switch:command"],
  "files.autoGuessEncoding": true,
  "editor.inlineSuggest.enabled": true,
  "editor.suggest.preview": true,
  "terminal.integrated.fontFamily": "DroidSansMono NFM",
  "terminal.integrated.fontSize": 9,
  "files.trimTrailingWhitespace": true,
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,
  "smoothtype.autoReload": true,
  "files.associations": {
    "*.py": "python"
  },
  "editor.suggest.localityBonus": true,
  "editor.stickyScroll.enabled": true,
  "git.openRepositoryInParentFolders": "prompt",
  "explorer.confirmDelete": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.fastScrollSensitivity": 10,
  "editor.fontVariations": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "typescript.tsserver.useSyntaxServer": "auto",
  "editor.autoClosingComments": "always",
  "window.autoDetectColorScheme": true,
  "extensions.experimental.deferredStartupFinishedActivation": true,
  "workbench.preferredDarkColorTheme": "Bearded Theme Surprising Blueberry",
  "git.enableSmartCommit": true,
  "workbench.activityBar.location": "top",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "files.autoSaveDelay": 1000,
  "editor.detectIndentation": true,
  "python.defaultInterpreterPath": "./venv/bin/python",
  "typescript.tsserver.web.projectWideIntellisense.enabled": false,
  "typescript.tsserver.web.typeAcquisition.enabled": false,
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  "tailwindCSS.emmetCompletions": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": false,
  "terminal.integrated.defaultProfile.windows": null,
  "github.copilot.chat.localeOverride": "es",
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.chat.editor.temporalContext.enabled": true,
  "github.copilot.chat.edits.temporalContext.enabled": true,
  "github.copilot.chat.languageContext.typescript.enabled": true,
  "github.copilot.chat.generateTests.codeLens": true,
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[graphql]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "emmet.showExpandedAbbreviation": "never",
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell"
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe"
      ],
      "args": [],
      "icon": "terminal-cmd"
    },
    "Git Bash": {
      "source": "Git Bash"
    }
  },
  "telemetry.editStats.showDecorations": true,
  "telemetry.editStats.showStatusBar": true
}
