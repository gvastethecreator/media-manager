{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶️ Dev",
      "type": "process",
      "command": "bun",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting development servers",
          "endsPattern": "\\[DEV\\] Development ready"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "dev:full"
      ]
    },
    {
      "label": "▶️ Dev: Vite",
      "type": "process",
      "command": "bun",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "🚀 Iniciando Vite\\+",
          "endsPattern": "Frontend ready at http://"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "dev:vite"
      ]
    },
    {
      "label": "▶️ Dev: Server",
      "type": "process",
      "command": "bun",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting backend",
          "endsPattern": "Backend ready at http://"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "dev:server:hot"
      ]
    },
    {
      "label": "💻 Desktop: Dev",
      "type": "process",
      "command": "bun",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "desktop:dev"
      ]
    },
    {
      "label": "🧪 Test",
      "type": "process",
      "command": "bun",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "test"
      ]
    },
    {
      "label": "🧪 Test: Tooling",
      "type": "process",
      "command": "bun",
      "group": "test",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "test:tooling"
      ]
    },
    {
      "label": "🎭 Test: E2E",
      "type": "process",
      "command": "bun",
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "test:e2e"
      ]
    },
    {
      "label": "🔎 Check",
      "type": "process",
      "command": "bun",
      "problemMatcher": [
        "$tsc"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "check"
      ]
    },
    {
      "label": "🧹 Lint",
      "type": "process",
      "command": "bun",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "lint"
      ]
    },
    {
      "label": "🧹 Lint: Fix",
      "type": "process",
      "command": "bun",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "lint:fix"
      ]
    },
    {
      "label": "🎨 Format",
      "type": "process",
      "command": "bun",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "format"
      ]
    },
    {
      "label": "📝 Typecheck",
      "type": "process",
      "command": "bun",
      "problemMatcher": [
        "$tsc"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "tsc"
      ]
    },
    {
      "label": "🏗️ Build",
      "type": "process",
      "command": "bun",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$tsc"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "build"
      ]
    },
    {
      "label": "🏗️ Build: Vite",
      "type": "process",
      "command": "bun",
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "build:vite"
      ]
    },
    {
      "label": "🏗️ Build: Server",
      "type": "process",
      "command": "bun",
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "build:server"
      ]
    },
    {
      "label": "📦 Desktop: Package",
      "type": "process",
      "command": "bun",
      "group": "build",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "desktop:package"
      ]
    },
    {
      "label": "📦 Deps",
      "type": "process",
      "command": "bun",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "deps:outdated"
      ]
    },
    {
      "label": "🗃️ DB: Studio",
      "type": "process",
      "command": "bun",
      "detail": "Opens Studio on the selected database. The file must already exist.",
      "isBackground": true,
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "db:studio",
        "--",
        "--database",
        "${input:mediaManagerDatabasePath}"
      ]
    },
    {
      "label": "🗃️ DB: Check",
      "type": "process",
      "command": "bun",
      "detail": "Checks the selected database. Does not write.",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "db:check",
        "--",
        "--database",
        "${input:mediaManagerDatabasePath}"
      ]
    },
    {
      "label": "⚠️ DB: Reset",
      "type": "process",
      "command": "bun",
      "detail": "Dry-run. Does not delete. Add --confirm RESET-DISPOSABLE only on a marked disposable database.",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "db:reset",
        "--",
        "--database",
        "${input:mediaManagerDisposableDatabasePath}"
      ]
    },
    {
      "label": "📋 Logs: List",
      "type": "process",
      "command": "bun",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "logs:list"
      ]
    },
    {
      "label": "🧹 Logs: Clean",
      "type": "process",
      "command": "bun",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "logs:clean"
      ]
    },
    {
      "label": "⚠️ Check: Errors",
      "type": "process",
      "command": "bun",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "check:errors"
      ]
    },
    {
      "label": "🎭 Playwright: Install",
      "type": "process",
      "command": "bun",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "playwright:install"
      ]
    },
    {
      "label": "🎭 Playwright: Codegen",
      "type": "process",
      "command": "bun",
      "isBackground": true,
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "run",
        "playwright:codegen"
      ]
    }
  ],
  "inputs": [
    {
      "id": "mediaManagerDatabasePath",
      "type": "promptString",
      "description": "Database path for Studio or Check",
      "default": "${workspaceFolder}/.scratch/dev.sqlite"
    },
    {
      "id": "mediaManagerDisposableDatabasePath",
      "type": "promptString",
      "description": "Disposable database path under .scratch or temp",
      "default": "${workspaceFolder}/.scratch/disposable.sqlite"
    }
  ]
}
