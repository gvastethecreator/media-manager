{
  "version": "2.0.0",
  "tasks": [
    // === TAREAS DE DESARROLLO (PRIORIDAD ALTA) ===
    {
      "label": "🚀 Desarrollo: Full Stack",
      "type": "shell",
      "command": "bun run dev:full",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "🚀 Iniciando desarrollo completo",
          "endsPattern": "\\[DEV\\] ✅ Desarrollo completo listo\\."
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false,
        "clear": false
      },
      "options": {
        "statusbar": {
          "label": "🚀 Dev Full",
          "color": "#00ff00"
        }
      }
    },
    {
      "label": "🌐 Desarrollo: Frontend (Vite+)",
      "type": "shell",
      "command": "bun run dev:vite",
      "group": "build",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "🚀 Iniciando Vite\\+",
          "endsPattern": "✅ Frontend listo en http://localhost:5173"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "⚙️ Desarrollo: Backend",
      "type": "shell",
      "command": "bun run dev:server:hot",
      "group": "build",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "🌟 Iniciando desarrollo del servidor",
          "endsPattern": "✅ Backend listo en http://localhost:4000"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "📱 Desarrollo: Tauri",
      "type": "shell",
      "command": "bun run dev:tauri",
      "group": "build",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🏗️ Build: Completo",
      "type": "shell",
      "command": "bun run build",
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🏗️ Build: Frontend (Vite+)",
      "type": "shell",
      "command": "bun run build:vite",
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "🏗️ Build: Backend",
      "type": "shell",
      "command": "bun run build:server",
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "🏗️ Build: Tauri",
      "type": "shell",
      "command": "bun run build:tauri",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "🧪 Test: E2E",
      "type": "shell",
      "command": "bun run test:e2e",
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    // Calidad de código
    {
      "label": "🧩 Check: Vite+",
      "type": "shell",
      "command": "bun run check",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "🎨 Format: Check",
      "type": "shell",
      "command": "bun run format:check",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "🎨 Format: Fix",
      "type": "shell",
      "command": "bun run format",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "🔍 Lint: Oxc",
      "type": "shell",
      "command": "bun run lint",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "🔧 Lint: Oxc Fix",
      "type": "shell",
      "command": "bun run lint:fix",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "📝 TypeScript: Check",
      "type": "shell",
      "command": "bun run tsc",
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "🗃️ DB: Studio",
      "type": "shell",
      "command": "bun run db:studio -- --database \"${input:mediaManagerDatabasePath}\"",
      "detail": "Abre Studio sólo en la base elegida.",
      "group": "build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🗃️ DB: Check",
      "type": "shell",
      "command": "bun run db:check -- --database \"${input:mediaManagerDatabasePath}\"",
      "detail": "Comprueba una base explícita sin cambiarla.",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "⚠️ DB: Reset disposable (dry-run)",
      "type": "shell",
      "command": "bun run db:reset -- --database \"${input:mediaManagerDisposableDatabasePath}\"",
      "detail": "No borra. Requiere una DB marcada bajo .scratch o temp.",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🔍 Logs: List",
      "type": "shell",
      "command": "bun run logs:list",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "🧹 Logs: Clean",
      "type": "shell",
      "command": "bun run logs:clean",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "⚠️ Check: Errors",
      "type": "shell",
      "command": "bun run check:errors",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "🎭 Playwright: Install",
      "type": "shell",
      "command": "bun run playwright:install",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "🎭 Playwright: Codegen",
      "type": "shell",
      "command": "bun run playwright:codegen",
      "group": "test",
      "isBackground": true,
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "mediaManagerDatabasePath",
      "type": "promptString",
      "description": "Ruta de la base para Studio o Check",
      "default": "${workspaceFolder}/.scratch/dev.sqlite"
    },
    {
      "id": "mediaManagerDisposableDatabasePath",
      "type": "promptString",
      "description": "Ruta descartable bajo .scratch o temp para el dry-run de reset",
      "default": "${workspaceFolder}/.scratch/dev.sqlite"
    }
  ]
}
